{%- comment -%}
  PDP CSS — above-fold files load eager (parser-blocking) because
  they style the LCP candidate (gallery main image), price, swatches,
  and the ATC button which sit above the fold on every product
  page. Accordion is below-fold (merchant description / shipping /
  returns copy) so its CSS loads async via the media="print"→all
  swap pattern — same trick theme.liquid uses for drawer/overlay
  CSS. Saves one parser-blocking round-trip on 4G mobile.

  noscript fallback ensures the accordion is styled when JavaScript
  is disabled (no onload event fires without JS).
{%- endcomment -%}
{{ 'kt-section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'kt-product-gallery.css' | asset_url | stylesheet_tag }}
{{ 'kt-product-price.css' | asset_url | stylesheet_tag }}
{{ 'kt-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'kt-product-form.css' | asset_url | stylesheet_tag }}
{{ 'kt-desc-truncate.css' | asset_url | stylesheet_tag }}
{%- if settings.kt_back_in_stock_enabled -%}
  {{ 'kt-back-in-stock.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{{ 'kt-product-accordion.css' | asset_url | stylesheet_tag }}

{%- assign main_product_countdown_label_default = 'kt.product.countdown.limited_time' | t -%}
{%- assign main_product_sample_header_default = 'kt.section.product_showroom.sample_header_default' | t -%}
{%- assign main_product_add_sample_default = 'kt.section.product_showroom.add_sample_default' | t -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="kt-pdp color-{{ section.settings.color_scheme | default: 'scheme-1' }}" data-section-id="{{ section.id }}" data-section-type="main-product">
  {%- comment -%}
    Breadcrumb at the very top of the PDP — sits between the
    header above and the gallery + info layout below, so the
    navigation trail is the first thing the shopper sees on the
    product page (collection → product name). Gated by the
    theme-global `settings.kt_show_breadcrumbs` toggle.
  {%- endcomment -%}
  {%- if settings.kt_show_breadcrumbs -%}
    {%- render 'breadcrumbs', class_extra: 'kt-breadcrumbs-wrap' -%}
  {%- endif -%}

  <div class="page-width">
    <div class="kt-pdp__layout">

      {%- comment -%} LEFT: Gallery {%- endcomment -%}
      <div class="kt-pdp__gallery-col">
        {%- render 'product-media-gallery', product: product -%}
      </div>

      {%- comment -%} RIGHT: Info — block-driven {%- endcomment -%}
      <div class="kt-pdp__info-col">
        <div class="kt-pdp__info-sticky" data-kt-pdp-anim-group>

          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'title' -%}
                <h1 class="kt-pdp__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
                {%- comment -%}
                  Variant SKU rendered for B2B / wholesale shoppers and
                  inventory tracking — Theme Store Section 7 expects SKU
                  visible and updated on variant change. JS in
                  assets/kt-product-form.js refreshes [data-product-sku]
                  on variant select.
                {%- endcomment -%}
                {%- if product.selected_or_first_available_variant.sku != blank -%}
                  <p class="kt-pdp__sku" data-product-sku>
                    <span class="visually-hidden">{{ 'kt.product.sku.label' | t | default: 'SKU' }}: </span>
                    {{ product.selected_or_first_available_variant.sku | escape }}
                  </p>
                {%- else -%}
                  <p class="kt-pdp__sku" data-product-sku hidden>
                    <span class="visually-hidden">{{ 'kt.product.sku.label' | t | default: 'SKU' }}: </span>
                  </p>
                {%- endif -%}

              {%- when 'meta' -%}
                {%- render 'pdp-meta', block: block, product: product, current_variant: current_variant -%}

              {%- when 'vendor' -%}
                {%- comment -%}
                  Vendor block — Theme Store: "Themes must support blocks
                  for all or most elements on the main section of the
                  product page (product price, vendor, description as
                  individual blocks)". Linked to the vendor's collection
                  by Shopify convention so customers can browse the rest
                  of that maker's catalog with one click; merchants who
                  treat vendor as a brand category get free cross-product
                  navigation. The block self-suppresses when product.vendor
                  is blank (Shopify allows vendor-less products) so the
                  PDP doesn't emit an empty link.
                {%- endcomment -%}
                {%- if product.vendor != blank -%}
                  <div class="kt-pdp__vendor" {{ block.shopify_attributes }}>
                    {%- if block.settings.show_label -%}
                      <span class="kt-pdp__vendor-label">{{ 'kt.product.vendor_label' | t | default: 'By' }}</span>
                    {%- endif -%}
                    <a href="{{ product.vendor | url_for_vendor }}" class="kt-pdp__vendor-link">
                      {{ product.vendor | escape }}
                    </a>
                  </div>
                {%- endif -%}

              {%- when 'countdown' -%}
                {%- liquid
                  # Block setting first (connect a date and time metafield as a
                  # dynamic source), then Theme settings > Product data.
                  assign deal_ends_at = block.settings.ends_at
                  if deal_ends_at == blank
                    assign mf_path = settings.kt_mf_deal_end | strip | split: '.'
                    if mf_path.size == 2
                      assign deal_ends_at = product.metafields[mf_path[0]][mf_path[1]].value
                    endif
                  endif
                -%}
                {%- if deal_ends_at == blank and request.design_mode -%}
                  <div class="kt-pdp__countdown-block kt-pdp__countdown-block--placeholder" {{ block.shopify_attributes }}>
                    <p class="kt-pdp__details-hint">{{ 'kt.product.countdown.editor_hint' | t }}</p>
                  </div>
                {%- elsif deal_ends_at != blank -%}
                  <div class="kt-pdp__countdown-block" {{ block.shopify_attributes }}>
                    <div class="kt-pdp__countdown-glow" aria-hidden="true"></div>
                    <div class="kt-pdp__countdown-top">
                      <div class="kt-pdp__countdown-label">
                        <span class="kt-pdp__countdown-dot" aria-hidden="true"></span>
                        <span>{{ block.settings.label | escape }}</span>
                      </div>
                      {%- if block.settings.badge != blank -%}
                        <span class="kt-pdp__countdown-badge">{{ block.settings.badge | escape }}</span>
                      {%- endif -%}
                    </div>
                    <div class="kt-pdp__countdown-bottom">
                      <div
                        class="kt-pdp__countdown-timer"
                        role="timer"
                        data-countdown
                        data-ends-at="{{ deal_ends_at | date: '%Y-%m-%dT%H:%M:%S%z' }}"
                        aria-label="{{ block.settings.label | default: main_product_countdown_label_default | escape }}"
                      >
                        <div class="kt-pdp__countdown-unit"><span class="kt-pdp__countdown-num" data-countdown-days>00</span><span class="kt-pdp__countdown-key">{{ 'kt.product.countdown.days_short' | t }}</span></div>
                        <span class="kt-pdp__countdown-colon">:</span>
                        <div class="kt-pdp__countdown-unit"><span class="kt-pdp__countdown-num" data-countdown-hours>00</span><span class="kt-pdp__countdown-key">{{ 'kt.product.countdown.hours_short' | t }}</span></div>
                        <span class="kt-pdp__countdown-colon">:</span>
                        <div class="kt-pdp__countdown-unit"><span class="kt-pdp__countdown-num" data-countdown-minutes>00</span><span class="kt-pdp__countdown-key">{{ 'kt.product.countdown.minutes_short' | t }}</span></div>
                        <span class="kt-pdp__countdown-colon">:</span>
                        <div class="kt-pdp__countdown-unit"><span class="kt-pdp__countdown-num" data-countdown-seconds>00</span><span class="kt-pdp__countdown-key">{{ 'kt.product.countdown.seconds_short' | t }}</span></div>
                      </div>
                      {%- if block.settings.ending_label != blank -%}
                        <div class="kt-pdp__countdown-ends">
                          <div class="kt-pdp__countdown-ends-label">{{ block.settings.ending_label | escape }}</div>
                          <div class="kt-pdp__countdown-progress"><div class="kt-pdp__countdown-progress-fill"></div></div>
                        </div>
                      {%- else -%}
                        <div class="kt-pdp__countdown-progress"><div class="kt-pdp__countdown-progress-fill"></div></div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'price' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'product-price', product: product -%}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  {%- if block.settings.truncate -%}
                    {%- assign word_limit_safe = block.settings.word_limit | default: 40 -%}
                    {%- assign desc_stripped = product.description | replace: '><', '> <' | replace: '<br', ' <br' | strip_html -%}
                    {%- assign desc_word_count = desc_stripped | split: ' ' | size -%}
                    {%- assign needs_toggle = false -%}
                    {%- if desc_word_count > word_limit_safe -%}
                      {%- assign needs_toggle = true -%}
                    {%- endif -%}
                    <div class="kt-pdp__short-desc kt-desc-truncate{% if needs_toggle %} kt-desc-truncate--toggle{% endif %}" data-desc-truncate {{ block.shopify_attributes }}>
                      <div class="kt-desc-truncate__short" data-desc-short>
                        {{ desc_stripped | truncatewords: word_limit_safe }}
                      </div>
                      {%- if needs_toggle -%}
                        <div class="kt-desc-truncate__full rte" data-desc-full hidden>
                          {{ product.description }}
                        </div>
                        <button
                          type="button"
                          class="kt-desc-truncate__toggle"
                          data-desc-toggle
                          aria-expanded="false"
                        >
                          <span data-desc-toggle-more>{{ 'kt.product.read_more' | t | default: 'Read more' }}</span>
                          <span data-desc-toggle-less hidden>{{ 'kt.product.read_less' | t | default: 'Read less' }}</span>
                        </button>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    <div class="kt-pdp__short-desc rte" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'variant_picker' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'product-variant-picker', product: product, section: section -%}
                </div>

              {%- when 'linked_products' -%}
                {%- render 'linked-products', block: block, product: product -%}

              {%- when 'buy_buttons' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'product-form', product: product, section: section -%}
                  {%- comment -%}
                    Pickup availability — rendered directly beneath the
                    Add-to-Cart so merchants running a retail shopfront
                    alongside their online store surface BOPIS before
                    the customer scrolls past checkout. Only renders
                    when the variant has at least one pick-up-enabled
                    location; the snippet handles its own empty state.
                  {%- endcomment -%}
                  {%- if block.settings.show_pickup_availability -%}
                    {%- render 'pickup-availability', variant: product.selected_or_first_available_variant, product: product -%}
                  {%- endif -%}
                </div>

              {%- when 'trust_badges' -%}
                <ul class="kt-pdp__trust-badges" role="list" {{ block.shopify_attributes }}>
                  {%- for i in (1..4) -%}
                    {%- assign icon_key = 'badge_' | append: i | append: '_icon' -%}
                    {%- assign text_key = 'badge_' | append: i | append: '_text' -%}
                    {%- assign icon_val = block.settings[icon_key] -%}
                    {%- assign text_val = block.settings[text_key] -%}
                    {%- if text_val != blank -%}
                      <li class="kt-pdp__trust-badge">
                        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          {%- case icon_val -%}
                            {%- when 'shipping' -%}
                              <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
                            {%- when 'returns' -%}
                              <polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            {%- when 'warranty' -%}
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            {%- when 'package' -%}
                              <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                          {%- endcase -%}
                        </svg>
                        {%- render 'trust-badge-text', icon: icon_val, text: text_val, class_prefix: 'kt-pdp' -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'accordion' -%}
                {%- comment -%}
                  Accordions are NOT rendered here. They're collected and
                  rendered in a full-width row BELOW the gallery+info
                  layout (see `.kt-pdp__details-full` after the layout) so
                  the two-column area stays balanced regardless of how many
                  gallery images or how long the buybox is. Nothing output
                  in the sticky info column for this block type.
                {%- endcomment -%}

              {%- when 'door_sample' -%}
                {%- assign sample_product = block.settings.sample_product -%}
                {%- if sample_product == blank and request.design_mode -%}
                  {%- comment -%}
                    Editor-only hint when the merchant added the door-
                    sample block but didn't pick a sample product yet.
                    Previously the snippet silently fell back to the
                    current PDP product (`| default: product`) which
                    rendered a self-sample button — confusing because
                    a $1 sample-box product is meant to be a tiny
                    physical preview, not the SKU shoppers are looking
                    at. Removing the fallback + showing this hint
                    forces the merchant to make a deliberate pick,
                    aligning with the showroom/door-sample UX intent.
                  {%- endcomment -%}
                  <div class="kt-pdp__door-sample kt-pdp__door-sample--placeholder" {{ block.shopify_attributes }}>
                    <p class="kt-pdp__details-hint">{{ 'kt.product.sample.editor_hint' | t }}</p>
                  </div>
                {%- elsif sample_product != blank -%}
                  {%- assign sample_variant = sample_product.selected_or_first_available_variant -%}
                  <div class="kt-pdp__door-sample" {{ block.shopify_attributes }}>
                    <div class="kt-pdp__door-sample-header">
                      <span class="kt-pdp__door-sample-title">{{ block.settings.header_title | default: main_product_sample_header_default }}</span>
                      {%- if block.settings.ships_badge != blank -%}
                        <span class="kt-pdp__door-sample-badge">{{ block.settings.ships_badge | escape }}</span>
                      {%- endif -%}
                    </div>
                    <div class="kt-pdp__door-sample-body">
                      <div class="kt-pdp__door-sample-info">
                        <h3 class="kt-pdp__door-sample-name">{{ sample_product.title | escape }}</h3>
                        <div class="kt-pdp__door-sample-price">
                          <span>{{ sample_variant.price | money }}</span>
                          {%- if block.settings.refundable -%}
                            <span class="kt-pdp__door-sample-refundable">{{ 'kt.product.sample.refundable' | t }}</span>
                          {%- endif -%}
                        </div>
                        {%- if block.settings.description != blank -%}
                          <p class="kt-pdp__door-sample-desc">{{ block.settings.description | escape }}</p>
                        {%- endif -%}
                      </div>
                      {%- form 'product', sample_product, id: 'DoorSampleForm-blk', class: 'kt-pdp__door-sample-form' -%}
                        <input type="hidden" name="id" value="{{ sample_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="kt-pdp__door-sample-btn" {% unless sample_variant.available %}disabled{% endunless %}>
                          {%- if sample_variant.available -%}
                            {{ block.settings.button_text | default: main_product_add_sample_default | escape }}
                          {%- else -%}
                            {{ 'kt.product.sold_out' | t }}
                          {%- endif -%}
                        </button>
                      {%- endform -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'concierge_box' -%}
                {%- comment -%}
                  CTA link resolution, in order of preference:
                    1. Merchant-picked `cta_link` (url type) — wins.
                    2. Store's Contact page via `pages.contact.url` —
                       carries the locale prefix for multi-language
                       stores and never 404s when the page doesn't
                       exist (resolves to blank, caught below).
                  We DO NOT hard-code '/pages/contact' as a fallback —
                  that path skips the routes object entirely, breaks
                  under localized URLs, and sends shoppers to a 404 on
                  any store whose contact page lives under a different
                  handle. If no URL can be resolved the link is hidden
                  instead of rendering a broken anchor.
                {%- endcomment -%}
                {%- assign concierge_cta_url = block.settings.cta_link | default: pages.contact.url -%}
                <div class="kt-pdp__concierge" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    {%- assign concierge_heading_tag = block.settings.heading_tag | default: 'h2' -%}
                    <{{ concierge_heading_tag }} class="kt-pdp__concierge-heading">{{ block.settings.heading | escape }}</{{ concierge_heading_tag }}>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <p class="kt-pdp__concierge-body">{{ block.settings.body | escape | newline_to_br }}</p>
                  {%- endif -%}
                  {%- if block.settings.cta_text != blank and concierge_cta_url != blank -%}
                    <a href="{{ concierge_cta_url | escape }}" class="kt-pdp__concierge-cta">
                      {{ block.settings.cta_text | escape }}
                      {% render 'icon-arrow-right', width: 14, height: 14, stroke_width: 1.6 %}
                    </a>
                  {%- endif -%}
                </div>

              {%- when 'spacer' -%}
                <div class="kt-pdp__spacer" style="--kt-spacer-h: {{ block.settings.height | default: 16 }}px;" {{ block.shopify_attributes }}></div>

              {%- when 'complementary_products' -%}
                {%- render 'pdp-complementary-products', block: block, product: product -%}

              {%- when 'payment_icons' -%}
                <div class="kt-pdp__payment-icons" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <p class="kt-pdp__payment-icons-heading">{{ block.settings.heading | escape }}</p>
                  {%- endif -%}
                  {%- if shop.enabled_payment_types.size > 0 -%}
                    <ul class="kt-pdp__payment-icons-list" role="list" aria-label="{{ 'kt.product.payment_icons.aria_label' | t | default: 'Accepted payment methods' }}">
                      {%- for type in shop.enabled_payment_types -%}
                        <li class="kt-pdp__payment-icon">
                          {{ type | payment_type_svg_tag: class: 'kt-pdp__payment-icon-svg' }}
                          <span class="visually-hidden">{{ type | replace: '_', ' ' | capitalize | escape }}</span>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- elsif request.design_mode -%}
                    <p class="kt-pdp__payment-icons-hint">
                      {{ 'kt.product.payment_icons.editor_hint' | t | default: 'Enable payment providers in Shopify admin → Settings → Payments to populate this block.' }}
                    </p>
                  {%- endif -%}
                </div>

              {%- when 'metafield' -%}
                {%- assign mf_ns = block.settings.namespace | default: 'custom' -%}
                {%- assign mf_key = block.settings.key -%}
                {%- if mf_ns != blank and mf_key != blank -%}
                  {%- assign mf_object = product.metafields[mf_ns][mf_key] -%}
                  {%- assign mf_value = mf_object.value -%}
                  {%- if mf_value != blank -%}
                    <div class="kt-pdp__metafield" {{ block.shopify_attributes }}>
                      {%- if block.settings.label != blank -%}
                        <p class="kt-pdp__metafield-label">{{ block.settings.label | escape }}</p>
                      {%- endif -%}
                      <div class="kt-pdp__metafield-value">
                        {{- mf_object | metafield_tag -}}
                      </div>
                    </div>
                  {%- elsif request.design_mode -%}
                    {%- comment -%} Editor hint when block is unconfigured {%- endcomment -%}
                    <div class="kt-pdp__metafield kt-pdp__metafield--placeholder" {{ block.shopify_attributes }}>
                      <p class="kt-pdp__metafield-hint">
                        {{ 'kt.product.metafield.editor_hint' | t | default: 'Configure namespace + key in the editor sidebar to surface a product metafield.' }}
                      </p>
                    </div>
                  {%- endif -%}
                {%- elsif request.design_mode -%}
                  <div class="kt-pdp__metafield kt-pdp__metafield--placeholder" {{ block.shopify_attributes }}>
                    <p class="kt-pdp__metafield-hint">
                      {{ 'kt.product.metafield.editor_hint' | t | default: 'Configure namespace + key in the editor sidebar to surface a product metafield.' }}
                    </p>
                  </div>
                {%- endif -%}

              {%- when 'specifications' -%}
                {%- liquid
                  assign spec_any = false
                  for i in (1..5)
                    assign label_key = 'label_' | append: i
                    assign value_key = 'value_' | append: i
                    if block.settings[label_key] != blank and block.settings[value_key] != blank
                      assign spec_any = true
                      break
                    endif
                  endfor
                -%}
                {%- if spec_any -%}
                  <div class="kt-pdp__specs" {{ block.shopify_attributes }}>
                    {%- if block.settings.title != blank -%}
                      {%- assign specs_heading_tag = block.settings.heading_tag | default: 'h2' -%}
                      <{{ specs_heading_tag }} class="kt-pdp__specs-title">{{ block.settings.title | escape }}</{{ specs_heading_tag }}>
                    {%- endif -%}
                    <dl class="kt-pdp__specs-list">
                      {%- for i in (1..5) -%}
                        {%- assign label_key = 'label_' | append: i -%}
                        {%- assign value_key = 'value_' | append: i -%}
                        {%- if block.settings[label_key] != blank and block.settings[value_key] != blank -%}
                          <div class="kt-pdp__specs-row">
                            <dt class="kt-pdp__specs-label">{{ block.settings[label_key] | escape }}</dt>
                            <dd class="kt-pdp__specs-value">{{ block.settings[value_key] | escape }}</dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  </div>
                {%- elsif request.design_mode -%}
                  <div class="kt-pdp__specs kt-pdp__specs--placeholder" {{ block.shopify_attributes }}>
                    <p class="kt-pdp__specs-hint">
                      {{ 'kt.product.specifications.editor_hint' | t | default: 'Add a label and value for each row, or connect the value field to a product metafield via the dynamic source icon.' }}
                    </p>
                  </div>
                {%- endif -%}

              {%- when 'product_details' -%}
                {%- render 'pdp-product-details', block: block, product: product -%}

              {%- when 'tags' -%}
                {%- comment -%}
                  Source priority for the PDP feature pill row:
                  1. `product.metafields.custom.features` (list.single_line_text_field)
                     — per-product, merchant-curated. Same metafield key
                     that the showroom template reads, so a merchant who
                     wires it once gets the pills on either template
                     without reconfiguration.
                  2. `product.tags` — Shopify's built-in tag list. Useful
                     fallback for merchants who tag products for filtering
                     and want those tags surfaced visibly without wiring
                     the metafield.
                  3. design_mode hint — only shown inside the theme editor
                     so merchants know where the pills will appear once
                     content is added.
                {%- endcomment -%}
                {%- liquid
                  # Block setting first (connect a list of single line text
                  # metafield as a dynamic source, or type comma-separated
                  # values), then Theme settings > Product data.
                  assign pdp_metafield_features = blank
                  assign pdp_block_features = block.settings.features
                  if pdp_block_features != blank
                    if pdp_block_features.first != blank
                      assign pdp_metafield_features = pdp_block_features
                    else
                      assign pdp_metafield_features = pdp_block_features | split: ','
                    endif
                  else
                    assign mf_path = settings.kt_mf_features | strip | split: '.'
                    if mf_path.size == 2
                      assign pdp_metafield_features = product.metafields[mf_path[0]][mf_path[1]].value
                    endif
                  endif
                -%}
                {%- assign pdp_has_metafield_features = false -%}
                {%- if pdp_metafield_features != blank and pdp_metafield_features.size > 0 -%}
                  {%- assign pdp_has_metafield_features = true -%}
                {%- endif -%}
                {%- if pdp_has_metafield_features -%}
                  <ul class="kt-pdp__tags" {{ block.shopify_attributes }} aria-label="{{ 'kt.product.tags_label' | t | default: 'Tags' }}">
                    {%- for feature_text in pdp_metafield_features -%}
                      {%- assign feature_text = feature_text | strip -%}
                      {%- if feature_text == blank -%}{%- continue -%}{%- endif -%}
                      <li class="kt-pdp__tag">{{ feature_text | escape }}</li>
                    {%- endfor -%}
                  </ul>
                {%- elsif product.tags.size > 0 -%}
                  <ul class="kt-pdp__tags" {{ block.shopify_attributes }} aria-label="{{ 'kt.product.tags_label' | t | default: 'Tags' }}">
                    {%- for tag in product.tags -%}
                      <li class="kt-pdp__tag">{{ tag | escape }}</li>
                    {%- endfor -%}
                  </ul>
                {%- elsif request.design_mode -%}
                  <div class="kt-pdp__tags kt-pdp__tags--placeholder" {{ block.shopify_attributes }}>
                    <p class="kt-pdp__tags-hint">
                      {{ 'kt.product.tags.editor_hint' | t | default: 'Tags appear here when the product has any assigned in Admin → Products → Tags.' }}
                    </p>
                  </div>
                {%- endif -%}

              {%- when 'liquid' -%}
                {%- comment -%}
                  Custom Liquid block — Theme Store requires Custom Liquid
                  blocks "wherever app blocks would be used". Sits next
                  to {%- when '@app' -%} so a merchant who needs to drop
                  in arbitrary Liquid (not packaged as an app extension)
                  has a first-class slot inside the PDP info column.
                {%- endcomment -%}
                <div class="kt-pdp__custom-liquid" {{ block.shopify_attributes }}>
                  {{ block.settings.custom_liquid }}
                </div>

              {%- when '@app' -%}
                <div class="kt-pdp__app-block" {{ block.shopify_attributes }}>
                  {%- render block -%}
                </div>

            {%- endcase -%}
          {%- endfor -%}

        </div>
      </div>

    </div>

    {%- comment -%}
      Product detail tabs — full-width row below the gallery+info layout
      (pulled out of the sticky info column). Rendered as a horizontal
      WAI-ARIA tab set (tablist + tabpanels) rather than a stacked
      accordion: tabs use the full content width naturally, so the label
      and the active state read at a glance instead of a toggle floating
      1400px to the right. Progressive enhancement — with JS disabled
      (`.no-js`) the tab bar hides and every panel shows stacked with its
      heading, so all content stays accessible. Blocks keep their order +
      shopify_attributes so the editor still selects/reorders them.
    {%- endcomment -%}
    {%- comment -%} Tabs with no content (for example an empty metafield) are skipped outside the editor. {%- endcomment -%}
    {%- assign kt_ti = 0 -%}
    {%- capture kt_tab_nav -%}{%- endcapture -%}
    {%- capture kt_tab_panels -%}{%- endcapture -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'accordion' -%}
        {%- capture accordion_content -%}
          {%- if block.settings.page != blank -%}
            {{ block.settings.page.content }}
          {%- else -%}
            {{ block.settings.content }}
          {%- endif -%}
        {%- endcapture -%}
        {%- if accordion_content == blank and request.design_mode == false -%}
          {%- continue -%}
        {%- endif -%}
        {%- capture kt_tab_nav -%}
          {{- kt_tab_nav -}}
          <button
            type="button"
            role="tab"
            id="kt-pdp-tab-{{ section.id }}-{{ block.id }}"
            class="kt-pdp__tab"
            aria-controls="kt-pdp-panel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if kt_ti == 0 %}true{% else %}false{% endif %}"
            tabindex="{% if kt_ti == 0 %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}
          >{{ block.settings.title | escape }}</button>
        {%- endcapture -%}
        {%- capture kt_tab_panels -%}
          {{- kt_tab_panels -}}
          <div
            role="tabpanel"
            id="kt-pdp-panel-{{ section.id }}-{{ block.id }}"
            class="kt-pdp__tab-panel"
            aria-labelledby="kt-pdp-tab-{{ section.id }}-{{ block.id }}"
            {% if kt_ti != 0 %}hidden{% endif %}
          >
            <h3 class="kt-pdp__tab-panel-title">{{ block.settings.title | escape }}</h3>
            <div class="kt-pdp__tab-panel-content rte">{{ accordion_content }}</div>
          </div>
        {%- endcapture -%}
        {%- assign kt_ti = kt_ti | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if kt_ti > 0 -%}
      <div class="kt-pdp__tabs" data-kt-pdp-tabs>
        <div class="kt-pdp__tabs-nav" role="tablist" aria-label="{{ 'kt.product.details.tabs_label' | t }}">
          {{- kt_tab_nav -}}
        </div>
        {{- kt_tab_panels -}}
      </div>
    {%- endif -%}
  </div>
</section>

{%- render 'product-sticky-bar', product: product, section: section -%}

<script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'kt-product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'kt-desc-truncate.js' | asset_url }}" defer="defer"></script>
{%- if settings.kt_back_in_stock_enabled -%}
  <script src="{{ 'kt-back-in-stock.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'kt-section-main-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'kt-section-main-product-tabs.js' | asset_url }}" defer="defer"></script>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  Selling-plan picker JS only emits when the product actually has
  subscription plans configured. Saves a ~1.5KB transfer on every
  non-subscription product page.
{%- endcomment -%}
{%- if product.selling_plan_groups.size > 0 -%}
  <script src="{{ 'selling-plan-picker.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- comment -%}
  Only load the product-model custom element registration when the
  product actually has 3D model media — avoids a no-op script request
  on products that only have 2D images. The <product-model> tag is
  only emitted by product-media-gallery.liquid when media.media_type
  equals 'model', so the registration is moot otherwise.
{%- endcomment -%}
{%- assign has_3d_model = false -%}
{%- for media in product.media -%}
  {%- if media.media_type == 'model' -%}
    {%- assign has_3d_model = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_3d_model -%}
  {%- comment -%} Shopify 3D viewer controls (zoom, fullscreen, AR) need their stylesheet. {%- endcomment -%}
  <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css">
  <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

