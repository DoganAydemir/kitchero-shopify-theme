<link rel="stylesheet" href="{{ 'kt-section-footer.css' | asset_url }}" media="all">

{%- assign footer_heading_line1_default = 'kt.section.footer.heading_line1_default' | t -%}
{%- assign footer_heading_line2_default = 'kt.section.footer.heading_line2_default' | t -%}
{%- assign footer_description_default = 'kt.section.footer.description_default' | t -%}
{%- assign footer_consent_label_default = 'kt.section.newsletter.consent_label_default' | t -%}

<footer class="kt-footer{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}" data-section-id="{{ section.id }}" style="">
  <div class="kt-footer__inner page-width">
    <div class="kt-footer__grid">

      {%- comment -%} Brand Column (always first) {%- endcomment -%}
      <div class="kt-footer__brand">
        {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
        <{{ heading_tag }} class="kt-footer__brand-heading">
          {{ section.settings.heading_line1 | default: footer_heading_line1_default }}<br>{{ section.settings.heading_line2 | default: footer_heading_line2_default }}
        </{{ heading_tag }}>
        <p class="kt-footer__brand-text">
          {{ section.settings.description | default: footer_description_default }}
        </p>

        <div class="kt-footer__social">
          {% render 'social-icons' %}
        </div>

        {%- comment -%}
          Follow on Shop — Theme Store paid mandatory feature (Section 4).
          `{{ shop | login_button: action: 'follow' }}` emits Shopify's
          native button that lets shoppers follow the store via the Shop
          app. Renders nothing when Shop login is unavailable on the
          merchant's plan, so it's always safe to include.
        {%- endcomment -%}
        {%- if section.settings.show_follow_on_shop -%}
          <div class="kt-footer__follow-on-shop">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.root_url | escape }}" class="kt-footer__cta">
            <span>{{ section.settings.cta_text }}</span>
            <span class="kt-footer__cta-arrow" aria-hidden="true">
              <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Dynamic Link Columns via Blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="kt-footer__column" {{ block.shopify_attributes }}>
              <h2 class="kt-footer__column-title">
                {{ block.settings.heading | default: block.settings.menu.title }}
              </h2>
              {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                <ul class="kt-footer__link-list list-unstyled">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="kt-footer__link{% if link.current %} kt-footer__link--current{% endif %}"
                        {% if link.current %}aria-current="page"{% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif request.design_mode -%}
                {%- comment -%}
                  Merchant hasn't picked a menu yet. Surface an onboarding
                  hint only inside the theme editor so shoppers on the
                  live storefront never see a broken/empty column. We
                  intentionally do NOT emit placeholder `href="#"` links:
                  those fail Theme Store review (deceptive navigation)
                  and they give shoppers non-functional click targets.
                {%- endcomment -%}
                <p class="kt-footer__empty-notice">
                  {{ 'kt.general.footer.empty_menu_notice' | t }}
                </p>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="kt-footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="kt-footer__column-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <div class="kt-footer__text rte">{{ block.settings.text }}</div>
            </div>

          {%- when 'newsletter' -%}
            <div class="kt-footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="kt-footer__column-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- assign footer_newsletter_id = 'FooterNewsletter-' | append: block.id -%}
              {%- form 'customer', id: footer_newsletter_id -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- comment -%}
                  No `contact[accepts_marketing]=true` hidden field —
                  pre-flagging marketing consent via a server-forced
                  default violates GDPR Art. 7 (consent must be
                  explicit, granular, informed) and is a Theme Store
                  reject signal. Shopify's native double-opt-in
                  confirmation email produces the legally-valid
                  record. Follows Shopify's recommended GDPR-compliant
                  marketing-consent flow.
                {%- endcomment -%}
                {%- if form.posted_successfully? -%}
                  <p class="kt-footer__newsletter-success" role="status">
                    {{ 'kt.section.newsletter-popup.success' | t | default: 'Thanks for subscribing.' }}
                  </p>
                {%- else -%}
                  <div class="kt-footer__newsletter">
                    <label for="footer-newsletter-email-{{ block.id }}" class="visually-hidden">{{ 'kt.newsletter.label' | t }}</label>
                    <input
                      type="email"
                      autocapitalize="off"
                      autocorrect="off"
                      spellcheck="false"
                      id="footer-newsletter-email-{{ block.id }}"
                      name="contact[email]"
                      class="kt-field__input kt-footer__newsletter-input"
                      placeholder="{{ 'kt.newsletter.label' | t }}"
                      required
                      maxlength="254"
                      inputmode="email"
                      enterkeyhint="send"
                      autocomplete="email"
                      value="{{ form.email | escape }}"
                      {% if form.errors %}
                        aria-invalid="true"
                        aria-describedby="FooterNewsletter-error-{{ block.id }}"
                      {% else %}
                        aria-invalid="false"
                      {% endif %}
                    >
                    {%- comment -%}
                      Honeypot — invisible to humans, populated by naive bots.
                      Backend can reject submissions where contact[website] is
                      non-empty. Field uses .kt-form__honeypot positioning trick
                      (off-screen, not display:none) so determined bots that
                      skip hidden fields still trip it. Matches pattern in
                      newsletter-signup.liquid and newsletter-popup.liquid.
                    {%- endcomment -%}
                    <p class="kt-form__honeypot" aria-hidden="true" inert>
                      <label for="footer-newsletter-website-trap-{{ block.id }}">{{ 'kt.a11y.honeypot' | t | default: 'Leave this field empty' }}</label>
                      <input type="text" id="footer-newsletter-website-trap-{{ block.id }}" name="contact[website]" tabindex="-1" autocomplete="off" aria-hidden="true">
                    </p>
                    <button type="submit" class="button kt-footer__newsletter-btn">
                      {{ 'kt.newsletter.button_label' | t }}
                    </button>
                  </div>
                  {%- if block.settings.show_consent_checkbox -%}
                    {%- comment -%}
                      Wrapper is a <div>, NOT a <p>. `consent_label` is a
                      richtext that defaults to `<p>I agree…</p>`. Putting
                      that inside an outer `<p>` is invalid nesting; the
                      HTML5 parser auto-closes the outer `<p>` the moment
                      it sees the inner one, orphaning the input from its
                      label. Strip the surrounding `<p>` tags from the
                      richtext so the label's contents (inline phrasing
                      only) sit cleanly inside the `<label>`. Matches the
                      identical fix in `sections/newsletter-signup.liquid`.
                    {%- endcomment -%}
                    {%- assign footer_consent_html = block.settings.consent_label | default: footer_consent_label_default -%}
                    {%- assign footer_consent_html = footer_consent_html | replace: '<p>', '' | replace: '</p>', '' -%}
                    <div class="kt-footer__newsletter-consent">
                      <input
                        type="checkbox"
                        id="footer-newsletter-consent-{{ block.id }}"
                        name="contact[accepts_marketing]"
                        value="true"
                        required
                      >
                      <label for="footer-newsletter-consent-{{ block.id }}" class="kt-footer__newsletter-consent-label">
                        {{- footer_consent_html -}}
                      </label>
                    </div>
                  {%- endif -%}
                  {%- if form.errors -%}
                    <div
                      class="kt-footer__newsletter-error"
                      id="FooterNewsletter-error-{{ block.id }}"
                      data-form-error-summary
                      tabindex="-1"
                    >
                      <h2 class="visually-hidden">{{ 'kt.contact.form.error_heading' | t | default: 'There was an error' }}</h2>
                      <ul class="kt-footer__newsletter-error-list" role="alert">
                        {%- for field in form.errors -%}
                          <li>
                            {%- if field == 'form' or field == 'email' -%}
                              <a href="#footer-newsletter-email-{{ block.id }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.translated_messages[field] }}</a>
                            {%- else -%}
                              {{ form.errors.translated_messages[field] }}
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                  {%- if shop.privacy_policy != blank -%}
                    <p class="kt-footer__newsletter-privacy">
                      <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>
                    </p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'image' -%}
            <div class="kt-footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- assign image_alt_text = block.settings.image.alt | default: '' | strip_html -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: sizes: '400px', class: 'kt-footer__block-image', loading: 'lazy', width: block.settings.image.width, height: block.settings.image.height, alt: image_alt_text }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg kt-footer__block-image' }}
              {%- endif -%}
            </div>

          {%- when 'contact_info' -%}
            {%- comment -%}
              Shop-level contact details pulled dynamically from
              `shop.address` / `shop.email` / `shop.phone` — all of
              which Admin → Settings → General populates. Previously
              merchants had to repeat this info in a plain text block
              (easy to forget, goes stale on move). Each line gated on
              its own toggle so a merchant who doesn't want to surface
              (e.g.) their phone publicly can hide it.
            {%- endcomment -%}
            <div class="kt-footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="kt-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <ul class="kt-footer__contact list-unstyled">
                {%- if block.settings.show_address and shop.address.street != blank -%}
                  <li class="kt-footer__contact-item">
                    <address class="kt-footer__contact-address">{{ shop.address | format_address }}</address>
                  </li>
                {%- endif -%}
                {%- if block.settings.show_email and shop.email != blank -%}
                  <li class="kt-footer__contact-item">
                    <a href="mailto:{{ shop.email | escape }}" class="kt-footer__contact-link">{{ shop.email | escape }}</a>
                  </li>
                {%- endif -%}
                {%- if block.settings.show_phone and shop.phone != blank -%}
                  <li class="kt-footer__contact-item">
                    {%- comment -%}
                      tel: scheme strips non-digit chars for dial-
                      friendliness (Safari iOS is picky about spaces
                      and dashes in the href), while the visible text
                      keeps the merchant's formatting.
                    {%- endcomment -%}
                    <a href="tel:{{ shop.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | escape }}" class="kt-footer__contact-link">{{ shop.phone | escape }}</a>
                  </li>
                {%- endif -%}
              </ul>
            </div>

          {%- when '@app' -%}
            <div class="kt-footer__column kt-footer__column--app" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Large Branding Text {%- endcomment -%}
    <div class="kt-footer__branding">
      {%- comment -%}
        Large editorial branding word at the bottom of the footer.
        Default fell back to the literal string 'KITCHERO' which is
        wrong on a non-Kitchero merchant install (theme reused in
        another store still reads "KITCHERO"). Default to the
        merchant's shop.name (uppercased to match the editorial
        treatment) so brand-new installs render the actual brand
        without manual setup. Merchants can still override with the
        branding_text setting.
      {%- endcomment -%}
      <span class="kt-footer__branding-text" aria-hidden="true" data-text="{{ section.settings.branding_text | default: shop.name | upcase | escape }}"></span>

      {%- comment -%} Bottom Bar {%- endcomment -%}
      <div class="kt-footer__bottom">
        {%- comment -%} Copyright {%- endcomment -%}
        <div class="kt-footer__copyright">
          <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.</span>
          {{ powered_by_link }}

          {%- if section.settings.show_cookie_preferences -%}
            {%- comment -%}
              JS-off case: the button has no functioning hook, so
              `html.no-js .kt-footer__cookie-preferences` rule in
              kt-section-footer.css hides it. JS-on: the global
              click handler in cookie-banner.js re-opens the banner.
            {%- endcomment -%}
            <button
              type="button"
              class="kt-footer__cookie-preferences"
              data-cookie-preferences
            >
              {{ 'kt.cookie_banner.manage_link' | t | default: 'Cookie preferences' }}
            </button>
          {%- endif -%}
        </div>

        {%- comment -%} Language/Country Selectors (Shopify native localization) {%- endcomment -%}
        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          <div class="kt-footer__selectors">
            {%- if localization.available_languages.size > 1 -%}
              {%- form 'localization', id: 'FooterLanguageForm', class: 'kt-footer__localization-form' -%}
                <input type="hidden" name="return_to" value="{{ request.path | escape }}">
                <div class="localization-selector">
                  <select name="language_code" id="FooterLanguageSelector" aria-label="{{ 'kt.locale.language_label' | t | default: 'Language' }}">
                    {%- for language in localization.available_languages -%}
                      <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                        {{ language.endonym_name | capitalize }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <noscript>
                    <button type="submit" class="button button--secondary">{{ 'kt.locale.update' | t | default: 'Update' }}</button>
                  </noscript>
                </div>
              {%- endform -%}
            {%- endif -%}

            {%- if localization.available_countries.size > 1 -%}
              {%- form 'localization', id: 'FooterCountryForm', class: 'kt-footer__localization-form' -%}
                <input type="hidden" name="return_to" value="{{ request.path | escape }}">
                <div class="localization-selector">
                  <select name="country_code" id="FooterCountrySelector" aria-label="{{ 'kt.locale.country_label' | t | default: 'Country/region' }}">
                    {%- for country in localization.available_countries -%}
                      <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </option>
                    {%- endfor -%}
                  </select>
                  <noscript>
                    <button type="submit" class="button button--secondary">{{ 'kt.locale.update' | t | default: 'Update' }}</button>
                  </noscript>
                </div>
              {%- endform -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Payment Icons (Shopify native) {%- endcomment -%}
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="kt-footer__payment">
            <ul class="kt-footer__payment-list list-unstyled" aria-label="{{ 'kt.general.footer.payment_methods' | t | escape }}">
              {%- for type in shop.enabled_payment_types -%}
                <li>
                  {{- type | payment_type_svg_tag: class: 'kt-footer__payment-icon' -}}
                  <span class="visually-hidden">{{ type | replace: '_', ' ' | capitalize | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        Shop policies row — renders only the policies the merchant has
        actually published in Admin → Settings → Policies. `shop.policies`
        already filters to published ones, so the `{% for %}` silently
        collapses to nothing on a store that has none. Keeps the legal
        links discoverable (a Theme Store review requirement) without
        forcing merchants to curate a separate menu.
      {%- endcomment -%}
      {%- if section.settings.show_policy_links and shop.policies.size > 0 -%}
        <nav class="kt-footer__policies" aria-label="{{ 'kt.general.footer.policies' | t | default: 'Legal' }}">
          <ul class="kt-footer__policies-list list-unstyled">
            {%- for policy in shop.policies -%}
              <li>
                <a href="{{ policy.url }}" class="kt-footer__policy-link">
                  {{ policy.title }}
                </a>
              </li>
            {%- endfor -%}
            {%- if section.settings.show_privacy_choices -%}
              {%- comment -%} Shopify creates the "Your Privacy Choices" page at /pages/data-sharing-opt-out when the data sharing opt-out page is on. {%- endcomment -%}
              {%- assign privacy_choices_url = pages['data-sharing-opt-out'].url | default: pages['your-privacy-choices'].url | default: shop.privacy_policy.url | default: routes.root_url -%}
              <li>
                <a
                  href="{{ privacy_choices_url }}"
                  class="kt-footer__policy-link"
                  data-privacy-choices
                >
                  {{ 'kt.cookie_banner.privacy_choices' | t | default: 'Your Privacy Choices' }}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__brand.content"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "t:sections.footer.settings.heading_line1.label",
      "default": "Let’s build your"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "t:sections.footer.settings.heading_line2.label",
      "default": "dream space."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.footer.settings.heading_tag.label",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.footer.settings.description.label",
      "default": "Add a short invitation for visitors to get in touch or start their project."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:sections.footer.settings.cta_text.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.footer.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__bottom.content"
    },
    {
      "type": "text",
      "id": "branding_text",
      "label": "t:sections.footer.settings.branding_text.label",
      "default": "Thoughtfully crafted, made to last."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:sections.footer.settings.show_follow_on_shop.label",
      "info": "t:sections.footer.settings.show_follow_on_shop.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cookie_preferences",
      "label": "t:sections.footer.settings.show_cookie_preferences.label",
      "info": "t:sections.footer.settings.show_cookie_preferences.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "t:sections.footer.settings.show_policy_links.label",
      "info": "t:sections.footer.settings.show_policy_links.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_privacy_choices",
      "label": "t:sections.footer.settings.show_privacy_choices.label",
      "info": "t:sections.footer.settings.show_privacy_choices.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.color_scheme.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme.label",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label",
          "default": "Footer column heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "default": "footer",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "Footer column heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label",
          "default": "<p>Stay in the loop on new arrivals and exclusive offers.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.newsletter.settings.heading.label",
          "default": "Subscribe"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.newsletter.settings.header__consent.content"
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.newsletter.settings.header__consent.info"
        },
        {
          "type": "checkbox",
          "id": "show_consent_checkbox",
          "label": "t:sections.footer.blocks.newsletter.settings.show_consent_checkbox.label",
          "info": "t:sections.footer.blocks.newsletter.settings.show_consent_checkbox.info",
          "default": false
        },
        {
          "type": "richtext",
          "id": "consent_label",
          "label": "t:sections.footer.blocks.newsletter.settings.consent_label.label",
          "info": "t:sections.footer.blocks.newsletter.settings.consent_label.info",
          "default": "<p>I agree to receive marketing emails. I can unsubscribe at any time.</p>"
        }
      ]
    },
    {
