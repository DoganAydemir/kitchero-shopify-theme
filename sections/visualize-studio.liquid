<link rel="stylesheet" href="{{ 'kt-section-visualize-studio.css' | asset_url }}" media="all">

{%- liquid
  capture visualize_inline_vars
    if section.settings.accent_color != blank
      echo '--kt-visualize-accent: '
      echo section.settings.accent_color
      echo ';'
    endif
  endcapture
-%}
<section
  class="kt-visualize-studio"
  data-section-id="{{ section.id }}"
  data-section-type="visualize-studio"
  {% if visualize_inline_vars != blank %}style="{{ visualize_inline_vars | strip_newlines }}"{% endif %}
>
  {%- comment -%} Immersive background {%- endcomment -%}
  <div class="kt-visualize-studio__bg" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: class: 'kt-visualize-studio__bg-img', loading: 'lazy', widths: '750, 1100, 1600, 2000', sizes: '100vw', width: section.settings.background_image.width, height: section.settings.background_image.height, alt: '' }}
    {%- else -%}
      <div class="kt-visualize-studio__bg-placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="kt-visualize-studio__bg-overlay"></div>
    <div class="kt-visualize-studio__bg-gradient"></div>
  </div>

  <div class="page-width kt-visualize-studio__content">
    <div class="kt-visualize-studio__grid">

      {%- comment -%} LEFT: heading + description {%- endcomment -%}
      <div class="kt-visualize-studio__text">
        <div class="kt-visualize-studio__eyebrow-row">
          <span class="kt-visualize-studio__rule" aria-hidden="true"></span>
          {%- if section.settings.eyebrow != blank -%}
            <p class="kt-visualize-studio__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
        </div>

        {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
        {%- if section.settings.heading_line1 != blank or section.settings.heading_line2 != blank -%}
          <{{ heading_tag }} class="kt-visualize-studio__heading">
            {{ section.settings.heading_line1 | escape }}
            {%- if section.settings.heading_line2 != blank -%}
              <br><span class="kt-visualize-studio__heading-italic">{{ section.settings.heading_line2 | escape }}</span>
            {%- endif -%}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="kt-visualize-studio__desc">{{ section.settings.description | escape | newline_to_br | replace: '<br />', '<br>' }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT: glassmorphic form {%- endcomment -%}
      <div class="kt-visualize-studio__form-wrap">
        <div class="kt-visualize-studio__form-card">
          {%- if section.settings.form_heading != blank -%}
            <h3 class="kt-visualize-studio__form-heading">{{ section.settings.form_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.form_subheading != blank -%}
            <p class="kt-visualize-studio__form-subheading">{{ section.settings.form_subheading | escape }}</p>
          {%- endif -%}

          {%- form 'contact', id: 'visualize-studio-form', class: 'kt-visualize-studio__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="kt-visualize-studio__success" role="status" data-contact-feedback="visualize-studio-form">
                {{ 'kt.contact.form.post_success' | t | default: 'Thanks — we will get back to you soon.' }}
              </p>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="kt-form__error-summary" data-form-error-summary tabindex="-1" data-contact-feedback="visualize-studio-form">
                <p class="kt-form__error-title" role="alert">{{ 'kt.section.contact.error_title' | t | default: 'Please correct the following:' }}</p>
                <ul class="kt-form__error-list">
                  {%- for field in form.errors -%}
                    <li>
                      {%- if field == 'form' -%}
                        {{ form.errors.translated_messages[field] }}
                      {%- elsif field == 'first_name' or field == 'last_name' or field == 'email' or field == 'phone' or field == 'body' -%}
                        {%- case field -%}
                          {%- when 'first_name' -%}{%- assign vs_field_id = 'VisualizeStudioFirstName' -%}
                          {%- when 'last_name' -%}{%- assign vs_field_id = 'VisualizeStudioLastName' -%}
                          {%- when 'email' -%}{%- assign vs_field_id = 'VisualizeStudioEmail' -%}
                          {%- when 'phone' -%}{%- assign vs_field_id = 'VisualizeStudioPhone' -%}
                          {%- else -%}{%- assign vs_field_id = 'VisualizeStudioMessage' -%}
                        {%- endcase -%}
                        <a href="#{{ vs_field_id }}-{{ section.id }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.translated_messages[field] }}</a>
                      {%- else -%}
                        {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.translated_messages[field] }}
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- comment -%}
              Same fields as the consultation drawer
              (snippets/appointment-drawer.liquid), so both consultation
              forms on the product page collect the same details. Hidden
              fields tell the merchant which form and product the request
              came from.
            {%- endcomment -%}
            {%- assign visualize_subject_default = 'kt.section.visualize_studio.subject_default' | t -%}
            {%- capture vs_request_type -%}
              {{ visualize_subject_default }}{% if section.settings.form_heading != blank %}: {{ section.settings.form_heading }}{% endif %}
            {%- endcapture -%}
            <input type="hidden" name="contact[Request type]" value="{{ vs_request_type | strip | escape }}">
            {%- if product -%}
              <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}: {{ request.origin }}{{ product.url }}">
            {%- endif -%}

            {%- assign vs_first_label = 'kt.section.appointment.first_name' | t -%}
            {%- assign vs_last_label = 'kt.section.appointment.last_name' | t -%}
            {%- assign vs_email_label = 'kt.section.appointment.email' | t -%}
            {%- assign vs_phone_label = 'kt.section.appointment.phone' | t -%}
            {%- assign vs_message_label = 'kt.section.appointment.message' | t -%}

            <div class="kt-visualize-studio__row">
              <div class="kt-visualize-studio__field">
                <label for="VisualizeStudioFirstName-{{ section.id }}" class="visually-hidden">{{ vs_first_label }}</label>
                <input
                  type="text"
                  id="VisualizeStudioFirstName-{{ section.id }}"
                  name="contact[first_name]"
                  placeholder="{{ vs_first_label | escape }}"
                  autocomplete="given-name"
                  required
                  {% if form.errors contains 'first_name' %}aria-invalid="true" aria-describedby="VisualizeStudioFirstName-{{ section.id }}-error"{% endif %}
                >
                {%- assign vs_first_error_id = 'VisualizeStudioFirstName-' | append: section.id | append: '-error' -%}
                {%- render 'form-field-error', form: form, field: 'first_name', describedby_id: vs_first_error_id -%}
              </div>

              <div class="kt-visualize-studio__field">
                <label for="VisualizeStudioLastName-{{ section.id }}" class="visually-hidden">{{ vs_last_label }}</label>
                <input
                  type="text"
                  id="VisualizeStudioLastName-{{ section.id }}"
                  name="contact[last_name]"
                  placeholder="{{ vs_last_label | escape }}"
                  autocomplete="family-name"
                  required
                  {% if form.errors contains 'last_name' %}aria-invalid="true" aria-describedby="VisualizeStudioLastName-{{ section.id }}-error"{% endif %}
                >
                {%- assign vs_last_error_id = 'VisualizeStudioLastName-' | append: section.id | append: '-error' -%}
                {%- render 'form-field-error', form: form, field: 'last_name', describedby_id: vs_last_error_id -%}
              </div>
            </div>

            <div class="kt-visualize-studio__field">
              <label for="VisualizeStudioEmail-{{ section.id }}" class="visually-hidden">{{ vs_email_label }}</label>
              <input
                type="email"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                id="VisualizeStudioEmail-{{ section.id }}"
                name="contact[email]"
                placeholder="{{ vs_email_label | escape }}"
                inputmode="email"
                autocomplete="email"
                required
                {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="VisualizeStudioEmail-{{ section.id }}-error"{% endif %}
              >
              {%- assign vs_email_error_id = 'VisualizeStudioEmail-' | append: section.id | append: '-error' -%}
              {%- render 'form-field-error', form: form, field: 'email', describedby_id: vs_email_error_id -%}
            </div>

            <div class="kt-visualize-studio__field">
              <label for="VisualizeStudioPhone-{{ section.id }}" class="visually-hidden">{{ vs_phone_label }}</label>
              <input
                type="tel"
                id="VisualizeStudioPhone-{{ section.id }}"
                name="contact[phone]"
                placeholder="{{ vs_phone_label | escape }}"
                inputmode="tel"
                autocomplete="tel"
                required
                {% if form.errors contains 'phone' %}aria-invalid="true" aria-describedby="VisualizeStudioPhone-{{ section.id }}-error"{% endif %}
              >
              {%- assign vs_phone_error_id = 'VisualizeStudioPhone-' | append: section.id | append: '-error' -%}
              {%- render 'form-field-error', form: form, field: 'phone', describedby_id: vs_phone_error_id -%}
            </div>

            <div class="kt-visualize-studio__field">
              <label for="VisualizeStudioMessage-{{ section.id }}" class="visually-hidden">{{ vs_message_label }}</label>
              <textarea
                id="VisualizeStudioMessage-{{ section.id }}"
                name="contact[body]"
                placeholder="{{ vs_message_label | escape }}"
                rows="4"
                maxlength="2000"
              ></textarea>
            </div>

            <p class="kt-form__honeypot" aria-hidden="true" inert>
              <label for="VisualizeStudioWebsiteTrap-{{ section.id }}">{{ 'kt.a11y.honeypot' | t | default: 'Leave this field empty' }}</label>
              <input type="text" id="VisualizeStudioWebsiteTrap-{{ section.id }}" name="contact[website]" tabindex="-1" autocomplete="off" aria-hidden="true">
            </p>

            {%- if shop.privacy_policy != blank -%}
              <p class="kt-visualize-studio__privacy">
                {{ 'kt.section.contact.privacy_note_html' | t: link: shop.privacy_policy.url }}
              </p>
            {%- endif -%}

            {%- assign visualize_submit_default = 'kt.section.visualize_studio.submit_default' | t -%}
            <button type="submit" class="kt-visualize-studio__submit">
              {{ section.settings.submit_text | default: visualize_submit_default }}
            </button>
          {%- endform -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.visualize-studio.name",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.visualize-studio.settings.background_image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.visualize-studio.settings.eyebrow.label",
      "default": "Visualize"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.visualize-studio.settings.accent_color.label",
      "info": "t:sections.visualize-studio.settings.accent_color.info",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "t:sections.visualize-studio.settings.heading_line1.label",
      "default": "Try it in your space"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "t:sections.visualize-studio.settings.heading_line2.label",
      "default": "and see your future design."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.visualize-studio.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.visualize-studio.settings.heading_tag.options__1.label"
        },
        {
          "value": "h3",
          "label": "t:sections.visualize-studio.settings.heading_tag.options__2.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.visualize-studio.settings.description.label",
      "default": "See how your space transforms — upload a photo, we'll do the rest."
    },
    {
      "type": "header",
      "content": "t:sections.visualize-studio.settings.header__form.content"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "t:sections.visualize-studio.settings.form_heading.label",
      "default": "Request a design consultation"
    },
    {
      "type": "text",
      "id": "form_subheading",
      "label": "t:sections.visualize-studio.settings.form_subheading.label",
      "default": "Quick previews. No signup needed."
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "t:sections.visualize-studio.settings.submit_text.label",
      "default": "Submit"
    }
  ],
  "presets": [
    {
      "name": "t:sections.visualize-studio.presets.name",
      "category": "Video"
    }
  ]
}
{% endschema %}
