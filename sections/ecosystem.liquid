<link rel="stylesheet" href="{{ 'kt-section-ecosystem.css' | asset_url }}" media="all">

{%- assign eco_scheme = section.settings.color_scheme | default: 'scheme-7' -%}
{%- assign eco_pad_top = section.settings.padding_top | default: 60 -%}
{%- assign eco_pad_bottom = section.settings.padding_bottom | default: 60 -%}
<section
  class="kt-ecosystem color-{{ eco_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="ecosystem"
  aria-labelledby="EcosystemTitle-{{ section.id }}"
  style="--kt-eco-pad-top: {{ eco_pad_top }}px; --kt-eco-pad-bottom: {{ eco_pad_bottom }}px;"
>
  {%- comment -%} Background grid pattern {%- endcomment -%}
  <div class="kt-ecosystem__grid-pattern" aria-hidden="true">
    <svg aria-hidden="true" focusable="false" fill="none" width="100%" height="100%">
      <defs>
        <pattern id="tech-grid-{{ section.id }}" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 40V.5H40" fill="none" stroke="white" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#tech-grid-{{ section.id }})" />
    </svg>
    <div class="kt-ecosystem__grid-fade"></div>
  </div>

  <div class="page-width">
    <div class="kt-ecosystem__layout">
      {%- comment -%} Left Column — Scrolling Text {%- endcomment -%}
      <div class="kt-ecosystem__text-col">
        <div class="kt-ecosystem__title-block">
          {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
          {%- comment -%}
            Guard the heading render so a merchant who clears the
            heading setting in the editor doesn't ship an empty
            `<h2></h2>` to the storefront. axe-core and Lighthouse
            flag empty headings as WCAG 1.3.1 violations.
          {%- endcomment -%}
          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} id="EcosystemTitle-{{ section.id }}" class="kt-ecosystem__title">{{ section.settings.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="kt-ecosystem__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        </div>

        <div class="kt-ecosystem__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="kt-ecosystem__feature eco-item" {{ block.shopify_attributes }}>
                <h3 class="kt-ecosystem__feature-title">{{ block.settings.title | escape }}</h3>
                <p class="kt-ecosystem__feature-desc">{{ block.settings.description | escape }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if section.settings.cta_text != blank -%}
            <div class="eco-item kt-ecosystem__cta-wrap">
              <a href="{{ section.settings.cta_link | default: routes.collections_url | escape }}" class="kt-ecosystem__cta">
                {{ section.settings.cta_text }}
                {% render 'icon-arrow-right', stroke_width: 1.5 %}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Right Column — Pinned Image {%- endcomment -%}
      <div class="kt-ecosystem__image-col">
        <div class="kt-ecosystem__image-wrap">
          {%- if section.settings.image != blank -%}
            {%- assign image_alt_text = section.settings.heading | default: '' | strip_html -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'kt-ecosystem__image', loading: 'lazy', widths: '375, 550, 750, 1100', sizes: '(min-width: 750px) 50vw, 100vw', width: section.settings.image.width, height: section.settings.image.height, alt: image_alt_text }}
            <div class="kt-ecosystem__image-overlay" aria-hidden="true"></div>
          {%- else -%}
            {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg kt-ecosystem__image' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'kt-section-ecosystem.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.ecosystem.name",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.ecosystem.settings.header__content.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.ecosystem.settings.heading.label",
      "info": "t:sections.ecosystem.settings.heading.info",
      "default": "Section heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.ecosystem.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.ecosystem.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.ecosystem.settings.heading_tag.options__3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.ecosystem.settings.subtitle.label",
      "default": "From layout planning to refined finishes, every detail is designed to create a kitchen that feels seamless, functional, and beautifully complete."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.ecosystem.settings.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.ecosystem.settings.header__cta.content"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:sections.ecosystem.settings.cta_text.label",
      "default": "Explore features"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.ecosystem.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.ecosystem.settings.header__appearance.content"
    },
    {
      "type": "header",
      "content": "t:sections.ecosystem.settings.header__padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "t:sections.ecosystem.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "t:sections.ecosystem.settings.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.shared.color_scheme.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme.label",
      "default": "scheme-7"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.ecosystem.blocks.feature.name",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.ecosystem.blocks.feature.settings.title.label",
          "default": "01 / Feature title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.ecosystem.blocks.feature.settings.description.label",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ecosystem.presets.name",
      "category": "Image",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "01 / Feature title",
            "description": ""
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "02 / Feature title",
            "description": ""
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "03 / Feature title",
            "description": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
