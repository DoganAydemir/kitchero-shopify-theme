
<link rel="stylesheet" href="{{ 'kt-section-financing-cta.css' | asset_url }}" media="all">

{%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}

<section
  class="kt-financing-cta color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style=""
  data-section-id="{{ section.id }}"
  data-section-type="financing-cta"
>
  <div class="page-width kt-financing-cta__inner">
    <{{ heading_tag }} class="kt-financing-cta__title">
      {%- if section.settings.heading_line1 != blank -%}
        <span>{{ section.settings.heading_line1 | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading_line2 != blank -%}
        <span class="kt-financing-cta__title-accent">{{ section.settings.heading_line2 | escape }}</span>
      {%- endif -%}
    </{{ heading_tag }}>

    {%- if section.settings.description != blank -%}
      <p class="kt-financing-cta__desc">{{ section.settings.description | escape | newline_to_br }}</p>
    {%- endif -%}

    {%- comment -%}
      Blank links fall back to the store's contact page (when it
      exists) and the collections list. Buttons without a URL are not
      rendered.
    {%- endcomment -%}
    {%- assign primary_href = section.settings.primary_link | default: pages['contact'].url -%}
    {%- assign secondary_href = section.settings.secondary_link | default: routes.collections_url -%}

    <div class="kt-financing-cta__buttons">
      {%- if section.settings.primary_text != blank and primary_href != blank -%}
        <a
          href="{{ primary_href | escape }}"
          class="kt-financing-cta__btn kt-financing-cta__btn--primary"
        >
          {{ section.settings.primary_text | escape }}
          {% render 'icon-arrow-right', width: 14, height: 14 %}
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_text != blank -%}
        <a
          href="{{ secondary_href | escape }}"
          class="kt-financing-cta__btn kt-financing-cta__btn--secondary"
        >
          {{ section.settings.secondary_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.financing-cta.name",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "t:sections.financing-cta.settings.heading_line1.label",
      "default": "Start your project"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "t:sections.financing-cta.settings.heading_line2.label",
      "default": "today."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.financing-cta.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.financing-cta.settings.description.label",
      "default": "Let shoppers know they can spread the cost of larger purchases with flexible payment options."
    },
    {
      "type": "header",
      "content": "t:sections.financing-cta.settings.header__buttons.content"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "t:sections.financing-cta.settings.primary_text.label",
      "default": "Apply Now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.financing-cta.settings.primary_link.label"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "t:sections.financing-cta.settings.secondary_text.label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.financing-cta.settings.secondary_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.shared.color_scheme.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:sections.financing-cta.presets.name",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
