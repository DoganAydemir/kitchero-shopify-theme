<link rel="stylesheet" href="{{ 'kt-section-featured-product.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'kt-product-price.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'kt-product-variant-picker.css' | asset_url }}" media="all">

{%- liquid
  assign product = all_products[section.settings.product]
  assign current_variant = product.selected_or_first_available_variant
  if product != blank and product.featured_media != blank
    assign media_ratio = product.featured_media.preview_image.aspect_ratio | default: 1
    assign media_height = 1200 | divided_by: media_ratio | round
  endif
  assign featured_product_add_to_cart_default = 'kt.product.add_to_cart' | t
-%}

{%- if product == blank -%}
  {%- if request.design_mode -%}
    <section
      class="kt-featured-product kt-featured-product--empty color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
      data-section-id="{{ section.id }}"
      data-section-type="featured-product"
      aria-label="{{ 'kt.section.featured_product.region_label' | t | default: 'Featured product' }}"
    >
      <div class="page-width">
        <div class="kt-featured-product__placeholder">
          <p class="kt-featured-product__placeholder-hint">
            {{ 'kt.section.featured_product.editor_hint' | t | default: 'Pick a product in the section settings to feature it here.' }}
          </p>
        </div>
      </div>
    </section>
  {%- endif -%}
  {%- comment -%} Live storefront: render nothing rather than a hollow band. {%- endcomment -%}
{%- else -%}

<section
  class="kt-featured-product color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style=""
  data-section-id="{{ section.id }}"
  data-section-type="featured-product"
  aria-label="{{ 'kt.section.featured_product.region_label' | t | default: 'Featured product' }}"
>
  <div class="page-width">
    <div class="kt-featured-product__layout">
      {%- comment -%}
        Media — `data-variant-featured-image` marks the wrapper so
        `assets/kt-product-form.js` can swap the inner `<img>`'s src/srcset
        to `variant.featured_image` when the customer picks a different
        variant. featured-product is a single static image with no
        gallery wrapper, so the gallery-dispatch path in kt-product-form.js
        (which looks for `[data-product-gallery]`) finds nothing here —
        without this hook the image silently stays on the original
        variant even as price/SKU/availability update around it (Theme
        Store atomic-variant-update rule).
      {%- endcomment -%}
      <div class="kt-featured-product__media" data-variant-featured-image>
        {%- if product != blank and product.featured_media != blank -%}
          {%- assign media_alt = product.featured_media.alt | default: product.title -%}
          {%- comment -%}
            Eager-load + high fetchpriority when this section is
            the first one on the page — featured-product is
            often used as a hero replacement on homepages and is
            the LCP candidate there. Below-fold instances stay
            lazy via the index check. Mirrors the same eager/lazy
            split product-card.liquid uses for collection cards.
          {%- endcomment -%}
          {%- if section.index0 == 0 -%}
            {%- assign fp_loading = 'eager' -%}
            {%- assign fp_priority = 'high' -%}
          {%- else -%}
            {%- assign fp_loading = 'lazy' -%}
            {%- assign fp_priority = 'auto' -%}
          {%- endif -%}
          {%- assign featured_media = product.featured_media -%}
          {%- case featured_media.media_type -%}
            {%- when 'video' -%}
              {%- render 'video-element', video: featured_media, class: 'kt-featured-product__image kt-featured-product__video', title: media_alt -%}
            {%- when 'external_video' -%}
              {{
                featured_media
                | external_video_tag:
                  class: 'kt-featured-product__image kt-featured-product__video',
                  loading: 'lazy',
                  title: media_alt
              }}
            {%- when 'model' -%}
              <product-model class="kt-featured-product__model" data-media-id="{{ featured_media.id }}">
                {{
                  featured_media
                  | model_viewer_tag:
                    image_size: '1200x',
                    reveal: 'interaction',
                    toggleable: true,
                    class: 'kt-featured-product__image'
                }}
              </product-model>
              {%- comment -%} Shopify 3D viewer controls (zoom, fullscreen, AR) need their stylesheet. {%- endcomment -%}
              <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css">
              <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
            {%- else -%}
              {{
                featured_media
                | image_url: width: 1200
                | image_tag:
                  class: 'kt-featured-product__image',
                  widths: '400, 600, 900, 1200',
                  sizes: '(min-width: 1024px) 50vw, 100vw',
                  width: 1200,
                  height: media_height,
                  alt: media_alt,
                  loading: fp_loading,
                  fetchpriority: fp_priority
              }}
          {%- endcase -%}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg kt-featured-product__image' }}
        {%- endif -%}
      </div>

      {%- comment -%} Info — block-driven {%- endcomment -%}
      <div class="kt-featured-product__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kt-featured-product__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              {%- assign heading_tag = block.settings.heading_tag | default: 'h2' -%}
              <{{ heading_tag }} class="kt-featured-product__title" {{ block.shopify_attributes }}>
                {%- if product != blank -%}
                  {{ product.title | escape }}
                {%- else -%}
                  {{ 'kt.onboarding.product_title' | t | default: 'Example product title' }}
                {%- endif -%}
              </{{ heading_tag }}>

            {%- when 'price' -%}
              <div class="kt-featured-product__price" {{ block.shopify_attributes }}>
                {%- if product != blank -%}
                  {%- render 'product-price', product: product, variant: current_variant -%}
                {%- else -%}
                  {%- comment -%} Currency-neutral placeholder — uses the store's money format. {%- endcomment -%}
                  <span class="kt-price">{{ 0 | money }}</span>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              <div class="kt-featured-product__description rte" {{ block.shopify_attributes }}>
                {%- if product != blank -%}
                  {%- assign word_limit_safe = block.settings.word_limit | default: 40 -%}
                  {{ product.description | replace: '><', '> <' | replace: '<br', ' <br' | strip_html | truncatewords: word_limit_safe }}
                {%- else -%}
                  {{ 'kt.onboarding.product_description' | t | default: 'Example product description goes here.' }}
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- if product != blank -%}
                <div class="kt-featured-product__variants" {{ block.shopify_attributes }}>
                  {%- render 'product-variant-picker', product: product, section: section -%}
                </div>
              {%- endif -%}

            {%- when 'buy_button' -%}
              {%- comment -%}
                `data-product-form` on the wrapper is the hook
                assets/kt-product-form.js uses to find the form (it avoids
                hyphenated {% form %} kwargs for robustness — see
                snippets/product-form.liquid). The hidden variant input
                gets `data-variant-id` so the JS can rewrite it when the
                customer picks a variant, and the submit button exposes
                `data-add-to-cart` + `data-add-to-cart-text` so the JS
                can toggle loading / sold-out / success labels without
                hand-querying by class name.
              {%- endcomment -%}
              <div class="kt-featured-product__form" data-product-form data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" {{ block.shopify_attributes }}>
                {%- if product != blank -%}
                  {%- comment -%}
                    Pre-compute the form id outside the {% form %}
                    tag — Shopify's form tag does not parse filter
                    chains (`| append:`) inside keyword-arg values
                    on some hosts; the parser then treats the
                    entire `id:` expression as the form type, which
                    surfaces as "Invalid form type 'template--...'"
                    once a real product is selected (placeholder
                    mode masks it because section.id has no value
                    in that branch). Assigning the id first keeps
                    the tag's keyword-arg list to literal scalars,
                    which Shopify accepts on every host.
                  {%- endcomment -%}
                  {%- assign featured_form_id = 'FeaturedProductForm-' | append: section.id -%}
                  {%- form 'product', product, id: featured_form_id -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                    {%- comment -%} Same gift card recipient fields as the main product form (snippets/product-form.liquid). {%- endcomment -%}
                    {%- if product.gift_card? -%}
                      {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
                      <script src="{{ 'gift-card-recipient.js' | asset_url }}" defer="defer"></script>
                    {%- endif -%}

                    {%- if product.selling_plan_groups.size > 0 -%}
                      {%- render 'product-selling-plans', product: product, current_variant: current_variant, section: section -%}
                    {%- endif -%}

                    {%- assign qty_min = current_variant.quantity_rule.min | default: 1 -%}
                    {%- assign qty_step = current_variant.quantity_rule.increment | default: 1 -%}
                    {%- assign qty_max = current_variant.quantity_rule.max -%}
                    <div class="kt-featured-product__qty-row">
                      <label for="FeaturedQuantity-{{ section.id }}" class="visually-hidden">{{ 'kt.product.quantity.label' | t }}</label>
                      <input
                        type="number"
                        name="quantity"
                        id="FeaturedQuantity-{{ section.id }}"
                        value="{{ qty_min }}"
                        min="{{ qty_min }}"
                        step="{{ qty_step }}"
                        {% if qty_max != blank %}max="{{ qty_max }}"{% endif %}
                        inputmode="numeric"
                        pattern="[0-9]*"
                        class="kt-featured-product__qty-input"
                        data-qty-input
                        data-qty-min="{{ qty_min }}"
                        data-qty-step="{{ qty_step }}"
                        {% if qty_max != blank %}data-qty-max="{{ qty_max }}"{% endif %}
                      >
                      <button
                        type="submit"
                        name="add"
                        class="kt-featured-product__submit button button--primary"
                        data-add-to-cart
                        {% unless current_variant.available %}disabled{% endunless %}
                      >
                        <span data-add-to-cart-text>
                          {%- if current_variant.available -%}
                            {{ block.settings.button_text | default: featured_product_add_to_cart_default }}
                          {%- else -%}
                            {{ 'kt.product.sold_out' | t | default: 'Sold out' }}
                          {%- endif -%}
                        </span>
                      </button>
                    </div>

                    {%- comment -%}
                      Pre-order indicator — variant out of stock with
                      inventory_policy:'continue' (back-order allowed).
                      Without it, the customer can't tell "in stock now"
                      from "ships when restocked".
                    {%- endcomment -%}
                    {%- assign fp_preorder_hidden = true -%}
                    {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' -%}
                      {%- assign fp_preorder_hidden = false -%}
                    {%- endif -%}
                    <p class="kt-featured-product__preorder" data-preorder role="note"{% if fp_preorder_hidden %} hidden{% endif %}>{{ 'kt.product.preorder' | t }}</p>

                    <div class="kt-featured-product__error" data-product-form-error role="alert" hidden></div>

                    <div
                      class="kt-featured-product__dynamic-checkout"
                      data-payment-button-wrapper
                      {% unless current_variant.available %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endunless %}
                    >
                      {{ form | payment_button }}
                    </div>
                    <div class="kt-featured-product__installments">
                      {{ form | payment_terms }}
                    </div>
                  {%- endform -%}
                {%- else -%}
                  <button type="button" class="kt-featured-product__submit button button--primary" disabled>
                    <span>{{ block.settings.button_text | default: featured_product_add_to_cart_default }}</span>
                  </button>
                {%- endif -%}
              </div>

            {%- when 'text' -%}
              <div class="kt-featured-product__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'liquid' -%}
              <div class="kt-featured-product__custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {%- when '@app' -%}
              <div class="kt-featured-product__app-block" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.view_product_link and product != blank -%}
          <a href="{{ product.url }}" class="kt-featured-product__view-link">
            {{ 'kt.product.view_details' | t | default: 'View full details' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  kt-product-form.js is shared between main-product, main-product-showroom,
  and featured-product (its init selector at line 1346 covers
  data-section-type="featured-product"). Without this script tag the
  variant picker UI renders but every interaction is dead — picking a
  swatch wouldn't update price, SKU, ATC state, or featured image, and
  /cart/add would silently keep submitting the initial variant.
{%- endcomment -%}
<script src="{{ 'kt-product-form.js' | asset_url }}" defer="defer"></script>

{%- if product.selling_plan_groups.size > 0 -%}
  <script src="{{ 'selling-plan-picker.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- endif -%}{%- comment -%} /product == blank branch above {%- endcomment -%}

{% schema %}
{
  "name": "t:sections.featured-product.name",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured-product.settings.product.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured-product.settings.eyebrow.label",
      "default": "Featured"
    },
    {
      "type": "checkbox",
      "id": "view_product_link",
      "label": "t:sections.featured-product.settings.view_product_link.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.color_scheme.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:sections.featured-product.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:sections.featured-product.blocks.title.settings.heading_tag.label",
          "options": [
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "price",
      "name": "t:sections.featured-product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "description",
      "name": "t:sections.featured-product.blocks.description.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "word_limit",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 40,
          "label": "t:sections.featured-product.blocks.description.settings.word_limit.label"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "t:sections.featured-product.blocks.variant_picker.name",
      "limit": 1
    },
    {
      "type": "buy_button",
      "name": "t:sections.featured-product.blocks.buy_button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.featured-product.blocks.buy_button.settings.button_text.label",
          "default": "Add to cart"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.featured-product.blocks.text.name",
      "limit": 4,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.featured-product.blocks.text.settings.text.label",
          "default": "<p>Crafted with care for everyday moments.</p>"
        }
      ]
    },
    {
      "type": "liquid",
      "name": "t:sections.featured-product.blocks.liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.featured-product.blocks.liquid.settings.custom_liquid.label",
          "info": "t:sections.featured-product.blocks.liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-product.presets.name",
      "category": "Product",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "description"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "buy_button"
        }
      ]
    }
  ]
}
{% endschema %}
