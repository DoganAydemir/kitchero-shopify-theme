{%- comment -%}
  Critical CSS (reset and base layout) inlined in <head>, so the first
  paint does not wait for an extra stylesheet request.
{%- endcomment -%}
<style>
/** Critical CSS for the theme. This file is included on every page. */
/** Based on Shopify's Skeleton theme (assets/critical.css). See assets/skeleton-theme.LICENSE.txt. */

/* Reset styles inspired by https://www.joshwcomeau.com/css/custom-css-reset/ */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  display: flex;
  flex-direction: column;
  margin: 0;
  min-height: 100svh;
}

html:has(dialog[scroll-lock][open], details[scroll-lock][open]) {
  overflow: hidden;
}

/* Media keep the height from their width/height attributes unless a
   component sets one (no `height: auto` here, unlike Skeleton). */
img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
}

input,
textarea,
select {
  border-radius: var(--style-border-radius-inputs);
}

select {
  background-color: var(--color-background);
  color: currentcolor;
}

dialog {
  background-color: var(--color-background);
  color: var(--color-foreground);
}

p {
  text-wrap: pretty;
}
p,
h1,
h2,
h3,
h4,
h5,
h6 {
  overflow-wrap: break-word;
}

/* Zero specificity (`:where`), so component classes keep their margins. */
:where(p:empty) {
  display: none;
}

:where(p, h1, h2, h3, h4, h5, h6):where(:first-child),
:where(:empty:first-child + :where(p, h1, h2, h3, h4, h5, h6)) {
  margin-block-start: 0;
}

:where(p, h1, h2, h3, h4, h5, h6):where(:last-child),
:where(:where(p, h1, h2, h3, h4, h5, h6) + :has(+ :empty:last-child)) {
  margin-block-end: 0;
}

/** Theme styles below */
html {
  font-size: calc(var(--kt-f-body-scale) * 100%);
  height: 100%;
}

body {
  font-family: var(--font-primary--family);
  font-style: var(--kt-f-body-style);
  font-weight: var(--kt-f-body-weight);
  font-size: 0.9375rem;
  letter-spacing: 0.02rem;
  line-height: 1.6;
  background-color: var(--color-background);
  color: var(--color-foreground);
}

@media screen and (min-width: 750px) {
  body {
    font-size: 1rem;
  }
}

/* The main content grows so the footer stays at the bottom of short pages. */
body > main {
  flex: 1 0 auto;
}

/** Block container layout utilities */

/**
 * Setup a grid that enables both full-width and constrained layouts
 * depending on the class of the child elements.
 *
 * By default, a minimum content margin is set on the left and right
 * sides of the container and the content is centered in the viewport
 * to not exceed the maximum page width.
 *
 * When a child element is given the `full-width` class, it will span
 * the entire viewport.
 */
.block-container {
  --content-width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );
  --content-margin: minmax(var(--page-margin), 1fr);
  --content-grid: var(--content-margin) var(--content-width) var(--content-margin);

  /* This is required to make <img> elements work as background images */
  position: relative;
  grid-template-columns: var(--content-grid);
  display: grid;
  text-align: var(--text-align, left);
  width: 100%;
}

/* Child elements, by default, are constrained to the central column of the grid. */
.block-container > * {
  grid-column: 2;
}

/* Child elements that use the full-width utility class span the entire viewport. */
.block-container > .full-width {
  grid-column: 1 / -1;
}
</style>
