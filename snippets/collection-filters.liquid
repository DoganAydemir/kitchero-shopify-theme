{%- comment -%}
  Collection Filters — renders Shopify native storefront filters.

  Active call sites (keep in sync when adding new consumers):
    • sections/main-collection-drawer.liquid   → mobile drawer variant
    • sections/main-collection-vertical.liquid → desktop sidebar variant
    • sections/main-search.liquid              → /search product-only scope

  Accepts:
  - layout: 'horizontal' | 'drawer' | 'vertical'  (visual only — no logic today)
  - collection: {Object} the collection (back-compat: used when filters/action_url omitted)
  - filters: {Array<Filter>} explicit filters array (preferred — for /search)
  - action_url: {String} form action URL (preferred — for /search)
  - form_id: {String} custom form id (default 'CollectionFiltersForm')
  - hidden_terms: {String} emits <input name="q" value="…"> when set (for /search)
  - hidden_type: {String} emits <input name="type" value="…"> when set (for /search)
  - hidden_options_prefix: {String} emits <input name="options[prefix]" value="…"> when set (for /search — typically "last")

  NOT used by sections/main-collection.liquid — that template ships a
  bespoke horizontal pill/dropdown filter bar with a separate mobile
  drawer that uses a different DOM (kt-filter-drawer__*). Intentional;
  don't try to consolidate without a visual-design pass.
{%- endcomment -%}

{%- liquid
  assign filter_list = filters | default: collection.filters
  assign filter_action = action_url | default: collection.url
  assign filter_form_id = form_id | default: 'CollectionFiltersForm'

  assign kt_zero_decimal_currencies = 'BIF,CLP,DJF,GNF,IDR,ISK,JPY,KMF,KRW,PYG,RWF,UGX,UYI,VND,VUV,XAF,XOF,XPF'
-%}

{%- if filter_list.size > 0 -%}
  <form id="{{ filter_form_id }}" action="{{ filter_action }}" method="get" data-collection-filters-form>
    {%- if hidden_terms -%}
      <input type="hidden" name="q" value="{{ hidden_terms | escape }}">
    {%- endif -%}
    {%- if hidden_type -%}
      <input type="hidden" name="type" value="{{ hidden_type | escape }}">
    {%- endif -%}
    {%- if hidden_options_prefix -%}
      <input type="hidden" name="options[prefix]" value="{{ hidden_options_prefix | escape }}">
    {%- endif -%}
    {%- for filter in filter_list -%}
      <div class="kt-filter" data-filter-group>
        {%- case filter.type -%}
          {%- comment -%}
            `boolean` filters (merchants marking a product metafield as
            filterable with a boolean type) share the same shape as
            `list` — they expose `filter.values` with a checked flag per
            value — so we dispatch them through the same checkbox
            renderer. Without this branch, any boolean-typed filter the
            merchant set up silently disappears from the sidebar.
          {%- endcomment -%}
          {%- when 'list' or 'boolean' -%}
            <details class="kt-filter__details"{% if filter.active_values.size > 0 %} open{% endif %}>
              <summary class="kt-filter__summary">
                <span class="kt-filter__title">{{ filter.label | escape }}</span>
                {%- if filter.active_values.size > 0 -%}
                  <span class="kt-filter__count">{{ filter.active_values.size }}</span>
                {%- endif -%}
                {% render 'icon-chevron-down', width: 14, height: 14, class: 'kt-filter__chevron' %}
              </summary>
              <div class="kt-filter__content">
                {%- comment -%}
                  Checkbox group needs an accessible name — the <summary> above
                  already contains {{ filter.label }}, but AT users treat the
                  <ul> as a separate landmark. role="group" + aria-label gives
                  screen readers the filter's name when they enter the list,
                  matching the <fieldset><legend> a11y pattern
                  without breaking the <details> styling.
                {%- endcomment -%}
                <div role="group" aria-label="{{ filter.label | escape }}">
                <ul
                  class="kt-filter__list list-unstyled"
                >
                  {%- for value in filter.values -%}
                    <li>
                      <label class="kt-filter__option">
                        <input
                          type="checkbox"
                          id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                          name="{{ value.param_name }}"
                          value="{{ value.value | escape }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 %}disabled{% endif %}
                          class="kt-filter__checkbox"
                          data-filter-checkbox
                        >
                        <span class="kt-filter__checkbox-visual">
                          {%- if value.active -%}
                            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                          {%- endif -%}
                        </span>

                        {%- assign kt_pn = filter.param_name | downcase -%}
                        {%- if kt_pn contains 'color' or kt_pn contains 'colour' or filter.presentation == 'swatch' -%}
                          {%- render 'kt-filter-swatch', value: value -%}
                        {%- endif -%}

                        <span class="kt-filter__label{% if value.count == 0 %} kt-filter__label--disabled{% endif %}">{{ value.label | escape }}</span>
                        <span class="kt-filter__value-count">({{ value.count }})</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
                </div>

                {%- if filter.active_values.size > 0 -%}
                  <a href="{{ filter.url_to_remove }}" class="kt-filter__reset">
                    {{ 'kt.section.collection.reset' | t | default: 'Reset' }}
                  </a>
                {%- endif -%}
              </div>
            </details>

          {%- when 'price_range' -%}
            <details class="kt-filter__details"{% if filter.min_value.value or filter.max_value.value %} open{% endif %}>
              <summary class="kt-filter__summary">
                <span class="kt-filter__title">{{ filter.label | escape }}</span>
                {% render 'icon-chevron-down', width: 14, height: 14, class: 'kt-filter__chevron' %}
              </summary>
              <div class="kt-filter__content">
                <div class="kt-filter__price-range">
                  <div class="kt-filter__price-field">
                    <label for="Filter-{{ filter.min_value.param_name }}" class="visually-hidden">{{ 'kt.section.collection.price_min' | t | default: 'From' }}</label>
                    <span class="kt-filter__price-prefix">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      id="Filter-{{ filter.min_value.param_name }}"
                      name="{{ filter.min_value.param_name }}"
                      value="{%- if filter.min_value.value -%}{{ filter.min_value.value | money_without_currency | remove: ',' }}{%- endif -%}"
                      placeholder="{{ 'kt.section.collection.price_min' | t | default: 'From' }}"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                      inputmode="decimal"
                      {% if kt_zero_decimal_currencies contains cart.currency.iso_code %}
                      step="1"
                      {% else %}
                      step="0.01"
                      {% endif %}
                      class="kt-filter__price-input"
                      data-filter-price
                    >
                  </div>
                  <span class="kt-filter__price-separator">–</span>
                  <div class="kt-filter__price-field">
                    <label for="Filter-{{ filter.max_value.param_name }}" class="visually-hidden">{{ 'kt.section.collection.price_max' | t | default: 'To' }}</label>
                    <span class="kt-filter__price-prefix">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      id="Filter-{{ filter.max_value.param_name }}"
                      name="{{ filter.max_value.param_name }}"
                      value="{%- if filter.max_value.value -%}{{ filter.max_value.value | money_without_currency | remove: ',' }}{%- endif -%}"
                      placeholder="{{ 'kt.section.collection.price_max' | t | default: 'To' }}"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                      inputmode="decimal"
                      {% if kt_zero_decimal_currencies contains cart.currency.iso_code %}
                      step="1"
                      {% else %}
                      step="0.01"
                      {% endif %}
                      class="kt-filter__price-input"
                      data-filter-price
                    >
                  </div>
                </div>
              </div>
            </details>
        {%- endcase -%}
      </div>
    {%- endfor -%}

    <noscript>
      <button type="submit" class="button">{{ 'kt.section.collection.apply' | t | default: 'Apply' }}</button>
    </noscript>
  </form>
{%- endif -%}
