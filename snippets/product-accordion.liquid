
{%- liquid
  assign accordion_style = style | default: 'default'
  assign accordion_class = 'kt-accordion'
  if accordion_style == 'serif'
    assign accordion_class = 'kt-accordion kt-accordion--serif'
  endif
-%}

<details class="{{ accordion_class }}" data-product-accordion {% if open %}open{% endif %} {{ shopify_attributes }}>
  <summary class="kt-accordion__header">
    <span class="kt-accordion__title">{{ title }}</span>
    <span class="kt-accordion__icon" aria-hidden="true">
      <span class="kt-accordion__icon-h"></span>
      <span class="kt-accordion__icon-v"></span>
    </span>
  </summary>
  <div class="kt-accordion__body">
    <div class="kt-accordion__content">
      {{ content }}
    </div>
  </div>
</details>
