
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign pf_uid = product.id -%}
{%- if section and section.id -%}
  {%- assign pf_uid = product.id | append: '-' | append: section.id -%}
{%- endif -%}
{%- assign product_form_id = 'ProductForm-' | append: pf_uid -%}
{%- if show_dynamic_checkout == nil -%}
  {%- assign show_dynamic_checkout = true -%}
{%- endif -%}
{%- if show_quantity == nil -%}
  {%- assign show_quantity = true -%}
{%- endif -%}

{%- comment -%}
  Wrapping div carries the `data-product-form` selector hook and the
  product id so kt-product-form.js can find the form without relying on
  hyphenated kwargs inside the `{% form %}` tag — Liquid's kwarg parser
  accepts `data-*: value` via a Shopify-specific extension, but passing
  empty strings (`data-product-form: ''`) is brittle and some linters
  flag the hyphens as arithmetic tokens. A plain <div> wrapper keeps
  the selector hooks out of Liquid-tag territory entirely.
{%- endcomment -%}
<div class="kt-product-form" data-product-form data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
{%- form 'product', product, id: product_form_id -%}
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

  {%- if product.gift_card? -%}
    {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
    <script src="{{ 'gift-card-recipient.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if product.selling_plan_groups.size > 0 -%}
    {%- render 'product-selling-plans', product: product, current_variant: current_variant, section: section -%}
  {%- endif -%}

  {%- comment -%}
    Quantity-rule resolution. Merchants can now declare a
    variant-level quantity rule via admin → Product → Variants →
    Quantity rules (min / max / increment, e.g. "sold in packs of 6").
    Shopify exposes these via `variant.quantity_rule.{min,max,increment}`
    — all three default to sensible integers (1/nil/1) when the
    merchant hasn't configured them, so this logic is safe for every
    product.
  {%- endcomment -%}
  {%- assign qty_min = current_variant.quantity_rule.min | default: 1 -%}
  {%- assign qty_step = current_variant.quantity_rule.increment | default: 1 -%}
  {%- assign qty_max = current_variant.quantity_rule.max -%}

  {%- assign safe_product_title = product.title | escape -%}

  {%- if show_quantity -%}
    <div class="kt-product-form__qty-row">
      <div class="kt-product-form__qty">
        <button type="button" class="kt-product-form__qty-btn" data-qty-minus aria-label="{{ 'kt.product.quantity.decrease' | t: title: safe_product_title }}">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
        <input
          type="number"
          name="quantity"
          id="Quantity-{{ pf_uid }}"
          value="{{ qty_min }}"
          min="{{ qty_min }}"
          step="{{ qty_step }}"
          {% if qty_max != blank %}max="{{ qty_max }}"{% endif %}
          inputmode="numeric"
          autocomplete="off"
          class="kt-product-form__qty-input"
          data-qty-input
          data-qty-min="{{ qty_min }}"
          data-qty-step="{{ qty_step }}"
          {% if qty_max != blank %}data-qty-max="{{ qty_max }}"{% endif %}
          aria-label="{{ 'kt.product.quantity.label' | t }}"
        >
        <button type="button" class="kt-product-form__qty-btn" data-qty-plus aria-label="{{ 'kt.product.quantity.increase' | t: title: safe_product_title }}">
          {% render 'icon-plus' %}
        </button>
      </div>
      {%- if qty_step > 1 or qty_min > 1 or qty_max != blank -%}
        <p class="kt-product-form__qty-rule" data-qty-rule role="note">
          {%- if qty_step > 1 -%}
            {{ 'kt.product.quantity.rule_increment_html' | t: count: qty_step }}
          {%- elsif qty_min > 1 -%}
            {{ 'kt.product.quantity.rule_min_html' | t: count: qty_min }}
          {%- elsif qty_max != blank -%}
            {{ 'kt.product.quantity.rule_max_html' | t: count: qty_max }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- comment -%}
      Hidden quantity for layouts that opt out of the visible stepper
      (showroom buy block, "1-click reserve" surface). /cart/add still
      needs the canonical `quantity` field; without it the endpoint
      silently defaults to 1, which breaks `quantity_rule.min > 1`
      variants (case-of-6 items, B2B).
    {%- endcomment -%}
    <input type="hidden" name="quantity" value="{{ qty_min }}">
  {%- endif -%}

  {%- assign atc_disabled = false -%}
  {%- unless current_variant.available -%}{%- assign atc_disabled = true -%}{%- endunless -%}

  <div class="kt-product-form__buy-row{% if show_dynamic_checkout %} kt-product-form__buy-row--paired{% endif %}">
    <button
      type="submit"
      class="kt-product-form__atc"
      {% if atc_disabled %}disabled{% endif %}
      data-add-to-cart
    >
      {%- if settings.kt_atc_show_icon -%}
        <svg class="kt-product-form__atc-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      {%- endif -%}
      <span data-add-to-cart-text>
        {%- if current_variant.available -%}
          {%- if atc_label != blank -%}
            {{ atc_label | escape }}
          {%- else -%}
            {{ 'kt.product.add_to_cart' | t }}
          {%- endif -%}
        {%- else -%}
          {{ 'kt.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>

    {%- comment -%} Dynamic Checkout Button (Buy Now / Shop Pay etc.) — sibling of ATC for the side-by-side layout {%- endcomment -%}
    {%- if show_dynamic_checkout -%}
      {%- comment -%}
        `data-payment-button-wrapper` is the JS hook that
        kt-product-form.js uses to disable Shop Pay / Apple Pay /
        Google Pay / Buy It Now in lockstep with the ATC button
        when the customer selects a sold-out variant. Shopify's
        custom checkout elements live in shadow DOM and don't
        expose `.disabled` directly, so we use pointer-events +
        opacity + aria-disabled at the wrapper level.
      {%- endcomment -%}
      <div
        class="kt-product-form__dynamic-checkout{% if settings.kt_buy_now_show_icon %} kt-product-form__dynamic-checkout--with-icon{% endif %}{% unless current_variant.available %} kt-product-form__dynamic-checkout--disabled{% endunless %}"
        data-payment-button-wrapper
        {% unless current_variant.available %}aria-disabled="true"{% endunless %}
      >
        {{ form | payment_button }}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Pre-order badge — shown when the variant is out of stock BUT the
    merchant has `inventory_policy: 'continue'` (keep selling when
    out of stock). Without this badge the customer can't distinguish
    "available now" from "ordered, ships when restocked" — both show
    the default Add-to-Cart button. Gated on both Shopify-tracked
    inventory and out-of-stock state to avoid false-positive badging
    on products whose merchant doesn't track stock at all.
  {%- endcomment -%}
  {%- assign preorder_initial_hidden = true -%}
  {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' -%}
    {%- assign preorder_initial_hidden = false -%}
  {%- endif -%}
  <p class="kt-product-form__preorder" data-preorder role="note"{% if preorder_initial_hidden %} hidden{% endif %}>
    {{ 'kt.product.preorder' | t }}
  </p>

  {%- comment -%}
    Error sentinel — populated by kt-product-form.js when /cart/add.js
    responds with an error (out of stock, quantity limit, network).
    Hidden by default; JS toggles [hidden] and fills textContent.
  {%- endcomment -%}
  <div class="kt-product-form__error" data-product-form-error role="alert" hidden></div>

  {%- comment -%}
    Back-in-stock notification — captures the customer's email when
    the selected variant is unavailable so the merchant can ping
    them on restock. Submissions land in Shopify Admin → Settings →
    Notifications → Customer contact (native contact form endpoint;
    no theme-side integration required). Gated on the theme setting
    `kt_back_in_stock_enabled` so merchants who handle restock
    notifications via a dedicated app (Klaviyo, Back in Stock, etc.)
    can disable the built-in form. The trigger button visibility
    mirrors the variant's `available` state — server-rendered for
    JS-off support, JS-toggled on variant change.
  {%- endcomment -%}
  {%- if settings.kt_back_in_stock_enabled -%}
    {%- render 'back-in-stock',
        product: product,
        variant: current_variant,
        section_id: pf_uid,
        heading: settings.kt_back_in_stock_heading,
        description: settings.kt_back_in_stock_description,
        show_name: settings.kt_back_in_stock_show_name,
        show_phone: settings.kt_back_in_stock_show_phone,
        render_mode: 'trigger'
    -%}
  {%- endif -%}

  <div class="kt-product-form__installments">
    {{ form | payment_terms }}
  </div>

  <div class="kt-product-form__actions">
    <button
      type="button"
      class="kt-product-form__action-btn"
      data-share-btn
      data-share-title="{{ product.title | escape }}"
      data-share-url="{{ request.origin }}{{ product.url }}"
      data-label-default="{{ 'kt.product.share' | t }}"
      data-label-copied="{{ 'kt.product.share_copied' | t }}"
    >
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
      </svg>
      <span data-share-label>{{ 'kt.product.share' | t }}</span>
    </button>
  </div>
{%- endform -%}

{%- comment -%}
  Back-in-stock modal — emitted AFTER the product form so the
  modal's `{% form 'contact' %}` is a sibling of the product form,
  not nested inside it. See snippets/back-in-stock.liquid's
  render_mode comment block + the trigger-render call above for
  the full rationale.
{%- endcomment -%}
{%- if settings.kt_back_in_stock_enabled -%}
  {%- render 'back-in-stock',
      product: product,
      variant: current_variant,
      section_id: pf_uid,
      heading: settings.kt_back_in_stock_heading,
      description: settings.kt_back_in_stock_description,
      show_name: settings.kt_back_in_stock_show_name,
      show_phone: settings.kt_back_in_stock_show_phone,
      render_mode: 'modal'
  -%}
{%- endif -%}
</div>
