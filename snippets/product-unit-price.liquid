{%- comment -%}
  Unit price for the selected variant (e.g. $3.99 / 100 g). Rendered when any
  variant has a unit price measurement; hidden for variants without one.
  assets/kt-product-form.js updates [data-unit-price] on variant change.

  Accepts:
  - product: {Object}
  - variant: {Object} selected variant
{%- endcomment -%}
  {%- assign has_any_unit_price = false -%}
  {%- for v in product.variants -%}
    {%- if v.unit_price_measurement -%}
      {%- assign has_any_unit_price = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if has_any_unit_price -%}
    {%- assign upm = variant.unit_price_measurement -%}
    <span class="kt-product-price__unit" data-unit-price{% unless upm %} style="display: none;"{% endunless %}>
      <span class="kt-product-price__unit-value">{% if upm %}{{ variant.unit_price | money }}{% endif %}</span>
      <span class="kt-product-price__unit-separator" aria-hidden="true">/</span>
      <span class="kt-product-price__unit-ref">
        {%- if upm -%}
          {%- if upm.reference_value != 1 -%}
            {{ upm.reference_value }}&nbsp;
          {%- endif -%}
          {{ upm.reference_unit }}
        {%- endif -%}
      </span>
    </span>
  {%- endif -%}
