
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign current_price = variant.price
  assign compare_price = variant.compare_at_price
  # Free-product guard — same pattern as product-price.liquid:21-29.
  # A 0-priced variant with compare > 0 would otherwise emit a "Save"
  # badge equal to the compare price and a "$0.00" current — both of
  # which read as broken merchandising. Substitute "Free" copy instead.
  assign is_free = false
  if current_price == 0
    assign is_free = true
  endif
  assign on_sale = false
  if compare_price > current_price and is_free == false
    assign on_sale = true
    assign savings = compare_price | minus: current_price
  endif

  assign financing_months = financing_months | default: 0 | floor
  assign financing_apr = financing_apr | default: 0 | times: 1.0
-%}

<div class="kt-showroom-price{% if on_sale %} kt-showroom-price--sale{% endif %}" data-product-price data-showroom-price>
  <span class="kt-showroom-price__label" data-showroom-sale-label{% unless on_sale %} hidden{% endunless %}>{{ 'kt.product.price.now_only' | t }}</span>

  <div class="kt-showroom-price__row">
    <span class="kt-showroom-price__current kt-product-price__current" data-free-text="{{ 'kt.cart.free' | t | default: 'Free' | escape }}">
      {%- if is_free -%}
        {{ 'kt.cart.free' | t | default: 'Free' }}
      {%- else -%}
        {{ current_price | money }}
      {%- endif -%}
    </span>
    {%- comment -%}
      Save / Was are always rendered (hidden when not on sale) and use their own
      data hooks, not the generic .kt-product-price__compare/__discount classes,
      so kt-showroom-price.js keeps their "Save $X" / "Was $X" wording in sync
      when the shopper picks a variant with a different sale state.
    {%- endcomment -%}
    {%- assign savings_money = savings | money -%}
    <span
      class="kt-showroom-price__save"
      data-showroom-save
      data-template="{{ 'kt.product.price.save_html' | t: amount: '[amount]' | escape }}"
      {% unless on_sale %}
        hidden
      {% endunless %}
    >
      {%- if on_sale -%}{{ 'kt.product.price.save_html' | t: amount: savings_money }}{%- endif -%}
    </span>
  </div>

  {%- assign compare_price_money = compare_price | money -%}
  <span
    class="kt-showroom-price__was"
    data-showroom-was
    data-template="{{ 'kt.product.price.was_html' | t: amount: '[amount]' | escape }}"
    {% unless on_sale %}
      hidden
    {% endunless %}
  >
    {%- if on_sale -%}{{ 'kt.product.price.was_html' | t: amount: compare_price_money }}{%- endif -%}
  </span>

  {%- render 'product-unit-price', product: product, variant: variant -%}

  {%- comment -%}
    Tax-inclusive indicator — Theme Store mandate (Section 7) for any
    PDP path that displays a price. The default `product-price.liquid`
    renders this; the showroom variant was missing it, so EU-market
    merchants running `product.showroom.json` shipped a price with no
    tax disclosure. Mirrors the wording / class used on the default
    PDP for visual consistency. Suppressed for free products — no
    tax discussion makes sense at $0.
  {%- endcomment -%}
  {%- if cart.taxes_included and is_free == false -%}
    <span class="kt-showroom-price__tax-note">
      {{ 'kt.product.taxes_included' | t | default: 'Tax included.' }}
    </span>
  {%- endif -%}

  {%- if financing_months > 0 and is_free == false -%}
    {%- liquid
      if financing_apr > 0
        assign monthly_rate = financing_apr | divided_by: 1200.0
        assign rate_plus_one = monthly_rate | plus: 1.0
        assign growth = 1.0
        for i in (1..financing_months)
          assign growth = growth | times: rate_plus_one
        endfor
        assign growth_minus_one = growth | minus: 1.0
        assign monthly = current_price | times: monthly_rate | times: growth | divided_by: growth_minus_one | round
      else
        assign monthly = current_price | times: 1.0 | divided_by: financing_months | round
      endif
    -%}
    <p class="kt-showroom-price__financing">
      <span
        class="kt-showroom-price__financing-pill"
        data-showroom-financing
        data-months="{{ financing_months }}"
        data-apr="{{ financing_apr }}"
      >
        {%- if financing_label != blank -%}
          {%- comment -%}
            Custom text. "[amount]" is replaced by the calculated monthly payment
            and kept in sync on variant change (kt-showroom-price.js); text
            without it stays the same for every variant.
          {%- endcomment -%}
          {%- assign financing_label_html = financing_label | escape -%}
          {%- if financing_label_html contains '[amount]' -%}
            {%- capture financing_amount_html -%}<span data-showroom-monthly>{{ monthly | money }}</span>{%- endcapture -%}
            {{ financing_label_html | replace: '[amount]', financing_amount_html }}
          {%- else -%}
            {{ financing_label_html }}
          {%- endif -%}
        {%- else -%}
          <span data-showroom-monthly>{{ monthly | money }}</span> {{ 'kt.product.price.per_month' | t }}
          {%- if financing_apr > 0 -%}
            &nbsp;· {{ 'kt.product.price.apr_suffix_html' | t: rate: financing_apr }}
          {%- endif -%}
          &nbsp;· {{ 'kt.product.price.months_html' | t: count: financing_months }}
        {%- endif -%}
      </span>
    </p>
    <p class="kt-showroom-price__financing-note">{{ 'kt.section.financing-calculator.disclaimer_default' | t }}</p>
  {%- endif -%}
</div>
