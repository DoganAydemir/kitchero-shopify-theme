{%- doc -%}
  Document head metadata: viewport, Open Graph, Twitter card, title,
  canonical URL, description, structured data and icons.

  Based on Shopify's Skeleton theme (`snippets/meta-tags.liquid`, see
  assets/skeleton-theme.LICENSE.txt). Kitchero adds a default share image,
  share-image sizing, robots rules for filtered and private pages, locale
  tags, extra product and article tags and JSON-LD,
  and favicon/theme-color tags. `<meta charset>` is the first tag in the
  layouts, before this snippet.
{%- enddoc -%}
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="referrer" content="strict-origin-when-cross-origin">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name | truncate: 160

  if request.page_type == 'product'
    assign og_type = 'product'
    if product and product.selected_variant
      assign og_url = canonical_url | append: '?variant=' | append: product.selected_variant.id
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # Kitchero: the share image falls back to the theme's default share image, then the brand logo.
  assign share_image = page_image
  if share_image == blank and settings.kt_default_share_image != blank
    assign share_image = settings.kt_default_share_image
  endif
  if share_image == blank and shop.brand.logo != blank
    assign share_image = shop.brand.logo
  endif
  if share_image != blank and share_image.width == 0
    assign share_image = settings.kt_default_share_image | default: shop.brand.logo
  endif
  if share_image != blank
    if share_image.width >= 1200
      assign og_image_width = 1200
      assign og_image_height = share_image.height | times: 1200 | divided_by: share_image.width
    else
      assign og_image_width = share_image.width
      assign og_image_height = share_image.height
    endif
    assign twitter_card = 'summary_large_image'
  else
    assign twitter_card = 'summary'
  endif

  assign twitter_handle = ''
  if settings.kt_social_twitter != blank
    assign twitter_handle = settings.kt_social_twitter | split: 'twitter.com/' | last | split: 'x.com/' | last | remove: '/' | remove_first: '@' | prepend: '@'
  endif
-%}

{%- comment -%}
  Sorted or filtered collection views are detected with documented Liquid
  (collection.sort_by is the sort_by URL parameter or nil; a filter is active
  when it has active values or a price bound). The request object has no
  query string property.
{%- endcomment -%}
{%- liquid
  assign collection_param_view = false
  if request.page_type == 'collection' and collection
    if collection.sort_by != blank
      assign collection_param_view = true
    endif
    for filter in collection.filters
      if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
        assign collection_param_view = true
        break
      endif
    endfor
  endif
-%}
{%- assign hidden_page_types = 'search,404,captcha,gift_card,password,cart,customers/login,customers/register,customers/account,customers/addresses,customers/order,customers/reset_password,customers/activate_account' | split: ',' -%}
{%- if hidden_page_types contains request.page_type -%}
  <meta name="robots" content="noindex">
{%- elsif collection_param_view -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

{%- liquid
  case request.locale.iso_code
    when 'en'
      assign og_locale = 'en_US'
    when 'tr'
      assign og_locale = 'tr_TR'
    when 'de'
      assign og_locale = 'de_DE'
    when 'fr'
      assign og_locale = 'fr_FR'
    when 'es'
      assign og_locale = 'es_ES'
    else
      if request.locale.iso_code contains '-'
        assign og_locale = request.locale.iso_code | replace: '-', '_'
      else
        assign og_locale_upper = request.locale.iso_code | upcase
        assign og_locale = request.locale.iso_code | append: '_' | append: og_locale_upper
      endif
  endcase
-%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
<meta
  property="og:locale"
  content="{{ og_locale }}"
>
{%- if shop.published_locales.size > 1 -%}
  {%- for locale in shop.published_locales -%}
    {%- unless locale.iso_code == request.locale.iso_code -%}
      {%- liquid
        case locale.iso_code
          when 'en'
            assign alt_locale = 'en_US'
          when 'tr'
            assign alt_locale = 'tr_TR'
          when 'de'
            assign alt_locale = 'de_DE'
          when 'fr'
            assign alt_locale = 'fr_FR'
          when 'es'
            assign alt_locale = 'es_ES'
          else
            if locale.iso_code contains '-'
              assign alt_locale = locale.iso_code | replace: '-', '_'
            else
              assign alt_locale_upper = locale.iso_code | upcase
              assign alt_locale = locale.iso_code | append: '_' | append: alt_locale_upper
            endif
        endcase
      -%}
      <meta property="og:locale:alternate" content="{{ alt_locale }}">
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}

{%- if share_image != blank -%}
  <meta
    property="og:image"
    content="https:{{ share_image | image_url: width: og_image_width }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_image | image_url: width: og_image_width }}"
  >
  <meta
    property="og:image:width"
    content="{{ og_image_width }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image_height }}"
  >
  <meta
    property="og:image:alt"
    content="{{ og_title | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  {%- comment -%}
    og:price:amount is product.price (cents) divided by 100, which is
    always denominated in the SHOP's primary currency — not the buyer's
    market currency. Earlier this snippet emitted og:price:currency from
    cart.currency.iso_code (buyer's currency under Markets), so a UK
    shopper visiting a USD-primary store published `og:price:amount=99.00`
    tagged with `og:price:currency=GBP` — a 28% mis-priced FB catalog
    feed. Pin currency to the shop primary so amount+currency stay in the
    same denomination.
  {%- endcomment -%}
  {%- assign og_price_decimal = product.price | divided_by: 100.0 | round: 2 -%}
  <meta property="og:price:amount" content="{{ og_price_decimal }}">
  <meta property="og:price:currency" content="{{ shop.currency.iso_code }}">
  {%- comment -%}
    Emit both the modern product:availability key AND the legacy
    og:availability key — FB Business and some product-catalog
    scrapers still expect og:availability with "instock"/"oos" form.
    product:brand + product:retailer_item_id (SKU) are required by
    Facebook Catalog / Shop feed ingestion. product:condition is a
    required FB catalog field; default to "new" — merchants selling
    refurbished/used can override via a future metafield.
  {%- endcomment -%}
  <meta property="product:availability" content="{% if product.available or product.gift_card? %}in stock{% else %}out of stock{% endif %}">
  <meta property="og:availability" content="{% if product.available or product.gift_card? %}instock{% else %}oos{% endif %}">
  <meta property="product:condition" content="new">
  {%- if product.vendor != blank -%}
    <meta property="product:brand" content="{{ product.vendor | escape }}">
  {%- endif -%}
  {%- assign active_variant = product.selected_or_first_available_variant -%}
  {%- if active_variant.sku != blank -%}
    <meta property="product:retailer_item_id" content="{{ active_variant.sku | escape }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Blog RSS/Atom link — lets RSS readers, podcast catchers, and
  Google Discover's feed backbone discover the blog's feed. Shopify
  auto-generates /<blog>.atom from every blog's articles. Gate on
  `blog` page-type so we only emit the link on blog / article pages
  where the `blog` object is populated.
{%- endcomment -%}
{%- if request.page_type == 'blog' or request.page_type == 'article' -%}
  {%- if blog != blank -%}
    <link rel="alternate" type="application/atom+xml" title="{{ blog.title | escape }}" href="{{ blog.url }}.atom">
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Article meta for FB/LinkedIn article share cards + social-graph
  indexing. The modern `article:*` namespace is scraped by both
  Facebook and LinkedIn; Twitter doesn't use them but does no harm.
  Gate on `article` to avoid emitting on non-article pages.
{%- endcomment -%}
{%- if request.page_type == 'article' and article -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
  {%- if blog.title != blank -%}
    {%- comment -%}
      Facebook's article scraper reads article:section to categorize
      the content in Open Graph news aggregation. blog.title is the
      closest section analog — e.g. "News", "Journal", "Design Tips".
    {%- endcomment -%}
    <meta property="article:section" content="{{ blog.title | escape }}">
  {%- endif -%}
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}
{%- endif -%}

<meta
  name="twitter:card"
  content="{{ twitter_card }}"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if twitter_handle != blank -%}
  <meta name="twitter:site" content="{{ twitter_handle }}">
  <meta name="twitter:creator" content="{{ twitter_handle }}">
{%- endif -%}
{%- if share_image != blank -%}
  <meta name="twitter:image" content="https:{{ share_image | image_url: width: og_image_width }}">
  <meta name="twitter:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

<title>
  {{- page_title | escape -}}
  {%- if current_tags -%}
    {%- assign safe_tags = current_tags | join: ', ' | escape -%}
    &ndash; {{ 'kt.meta.tags' | t: tags: safe_tags }}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'kt.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

{%- comment -%} Filtered, sorted and search result URLs point to their unfiltered page. {%- endcomment -%}
{%- liquid
  assign canonical = canonical_url
  if collection_param_view
    assign canonical = request.origin | append: collection.url
  elsif request.page_type == 'search'
    assign canonical = request.origin | append: routes.search_url
  endif
-%}
<link
  rel="canonical"
  href="{{ canonical }}"
>

{%- comment -%}
  No hreflang tags here: Shopify adds them for every published language and
  market through content_for_header (layout/theme.liquid), and adding a
  second set creates duplicate or conflicting annotations.
{%- endcomment -%}

<meta
  name="description"
  content="{{ og_description | escape }}"
>

{%- if request.page_type == 'product' and product -%}
  {%- comment -%}
    aggregateRating supplement — Shopify's native `| structured_data`
    filter emits Product with price/availability/SKU/image but does
    NOT automatically pull `product.metafields.reviews.rating` into
    schema. The theme DOES render stars on the PDP reading that
    metafield, so Google's Rich Results Test flags "Review snippets
    not present" — visible UI, absent schema. Emit a supplementary
    Product block with matching @id (the canonical URL Shopify uses);
    Google merges multiple same-@id Product schemas per spec.
    Gated on the metafield existing — new stores without reviews
    installed get nothing extra.
  {%- endcomment -%}
  {%- liquid
    assign sd_manual_rating = blank
    assign mf_path = settings.kt_mf_rating | strip | split: '.'
    if mf_path.size == 2
      assign sd_manual_rating = product.metafields[mf_path[0]][mf_path[1]].value
    endif
  -%}
  {%- assign sd_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: sd_manual_rating -%}
  {%- assign sd_rating_count = product.metafields.reviews.rating_count.value -%}
  {%- assign sd_rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5 -%}
  {%- if sd_rating and sd_rating_count and sd_rating_count > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "@id": {{ canonical_url | json }},
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ sd_rating | json }},
          "bestRating": {{ sd_rating_scale | json }},
          "worstRating": 1,
          "reviewCount": {{ sd_rating_count | json }}
        }
      }
    </script>
  {%- endif -%}
  {%- assign sd_variant = product.selected_or_first_available_variant -%}
  {%- assign sd_gtin = blank -%}
  {%- if sd_variant.barcode != blank -%}
    {%- assign sd_barcode_clean = sd_variant.barcode | strip -%}
    {%- assign sd_barcode_size = sd_barcode_clean | size -%}
    {%- if sd_barcode_size == 13 or sd_barcode_size == 12 or sd_barcode_size == 8 -%}
      {%- assign sd_gtin = sd_barcode_clean -%}
    {%- endif -%}
  {%- endif -%}
  {%- if product.vendor != blank or sd_gtin != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "@id": {{ canonical_url | json }}
        {%- if product.vendor != blank -%}
        ,"brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        }
        {%- endif -%}
        {%- if sd_gtin != blank -%}
        ,{%- assign sd_gtin_size = sd_gtin | size -%}
        {%- if sd_gtin_size == 13 -%}"gtin13"{%- elsif sd_gtin_size == 12 -%}"gtin12"{%- else -%}"gtin8"{%- endif -%}: {{ sd_gtin | json }}
        {%- endif -%}
        {%- if sd_variant.sku != blank -%}
        ,"mpn": {{ sd_variant.sku | json }}
        {%- endif -%}
      }
    </script>
  {%- endif -%}
{%- elsif request.page_type == 'article' and article -%}
  <script type="application/ld+json">{{ article | structured_data }}</script>
  {%- assign article_publisher_logo = settings.kt_logo | default: shop.brand.logo -%}
  {%- comment -%}
    Build the description for the Article rich result. Google
    flags missing description as a REJECT-grade validator error.
    Resolution chain: merchant-set `article.excerpt` (richtext)
    → first 160 chars of `article.content` stripped → article
    title as last-resort. `strip_html` removes tags so the
    description is plain text. `truncate: 200, '…'` keeps the
    SERP snippet under Google's 160-character display cap with
    buffer for word boundaries.
  {%- endcomment -%}
  {%- assign article_description = article.excerpt | default: article.content | replace: '><', '> <' | replace: '<br', ' <br' | strip_html | strip | truncate: 200, '…' -%}
  {%- comment -%}
    Logo dimensions — Google's Article publisher.logo schema
    requires width + height numerics on the ImageObject. Pin
    width to 600 (matches the image_url filter above) and
    derive height from the asset's intrinsic aspect ratio so
    the ratio is accurate per scheme.
  {%- endcomment -%}
  {%- if article_publisher_logo != blank -%}
    {%- assign article_publisher_logo_h = 600 | times: article_publisher_logo.height | divided_by: article_publisher_logo.width -%}
  {%- endif -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": {{ canonical_url | json }},
      {%- if article_description != blank -%}
        "description": {{ article_description | json }},
      {%- endif -%}
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonical_url | json }}
      },
      "publisher": {
        "@type": "Organization",
        "@id": {{ request.origin | append: '#organization' | json }},
        "name": {{ shop.name | json }}
        {%- if article_publisher_logo != blank -%}
        ,"logo": {
          "@type": "ImageObject",
          "url": {{ article_publisher_logo | image_url: width: 600 | prepend: 'https:' | json }},
          "width": 600,
          "height": {{ article_publisher_logo_h | json }}
        }
        {%- endif -%}
      }
    }
  </script>
{%- endif -%}

{%- liquid
  assign theme_color = '#FAFAF9'
  for scheme in settings.kt_schemes
    assign theme_color = scheme.settings.surface
    break
  endfor
-%}
<meta name="theme-color" content="{{ theme_color }}">
{%- if settings.kt_favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.kt_favicon | image_url: width: 32, height: 32 }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.kt_favicon | image_url: width: 192, height: 192 }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.kt_favicon | image_url: width: 180, height: 180 }}">
{%- endif -%}
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="{{ shop.name | escape }}">
<meta name="format-detection" content="telephone=no">
