{%- comment -%}
  Product details block (SKU, barcode, weight, vendor, type, dimensions, origin, tags) for main-product.
  Accepts: block, product
{%- endcomment -%}
{%- comment -%}
  Auto-rendered product metadata list. Merchants drop
  this block in once and toggle which of the seven
  common fields they want surfaced (SKU, barcode,
  weight, vendor, type, dimensions, country of
  origin). All values pull from variant / product
  natively — no manual label/value entry, no
  per-product editing. Empty values self-suppress so
  a row only renders when the underlying field is
  set. Use this when the merchant wants a clean
  spec sheet that always matches the admin data;
  use the `specifications` block instead for
  bespoke label/value rows (custom dimensions,
  warranty terms, finish names, etc.).

  Weight is rendered through `| weight_with_unit`
  so it honors the merchant's shop weight unit
  (kg/g/lb/oz) — pulls from the variant when set,
  silently skipped at 0 (Shopify's "weight not set"
  signal).

  Dimensions are NOT exposed to storefront Liquid
  by Shopify (the package profile under Shipping is
  used by the checkout shipping calculator, not the
  PDP). When the merchant turns on `show_dimensions`
  the block pulls from a metaobject reference if
  configured, falling back to a metafield triplet
  (custom.length / width / height) for shops that
  prefer the legacy metafield route.
{%- endcomment -%}
{%- liquid
  # Per-row "should render" flags are computed once here
  # and reused both for the outer pd_any flag (which
  # wraps the description list) and each row's own
  # if-guard at the render site. The earlier pattern
  # repeated the same `block.settings.show_X and X !=
  # blank` expression in two places per row — a
  # maintenance hazard (if one guard drifts the list
  # might open with no children, or a row might render
  # with an empty label). Centralizing the truth table
  # here keeps the render site readable and DRY.
  assign pd_variant = product.selected_or_first_available_variant

  # Variant-dependent rows (SKU / Barcode / Weight) — render
  # the row markup as long as the merchant has the toggle
  # ON, even when the FIRST variant's value is blank. The
  # row wrapper carries the `hidden` attribute and JS
  # un-hides it on variant change when the matched
  # variant has data. Without this two-state pre-render
  # the variant-change refresh would have nothing to
  # write into.
  assign pd_render_sku = block.settings.show_sku
  assign pd_render_barcode = block.settings.show_barcode
  assign pd_render_weight = block.settings.show_weight

  # Product-level rows (vendor / type / origin / tags /
  # dimensions) DON'T change across variants — only
  # render them when the underlying field actually has
  # data. An empty toggle here would surface a label
  # with an empty value.
  assign pd_render_vendor = false
  if block.settings.show_vendor and product.vendor != blank
    assign pd_render_vendor = true
  endif
  assign pd_render_type = false
  if block.settings.show_type and product.type != blank
    assign pd_render_type = true
  endif
  assign pd_origin = blank
  assign pd_origin = block.settings.origin
  if pd_origin == blank
    assign mf_path = settings.kt_mf_origin | strip | split: '.'
    if mf_path.size == 2
      assign pd_origin = product.metafields[mf_path[0]][mf_path[1]].value
    endif
  endif
  assign pd_render_origin = false
  if block.settings.show_origin and pd_origin != blank
    assign pd_render_origin = true
  endif
  assign pd_render_tags = false
  if block.settings.show_tags and product.tags.size > 0
    assign pd_render_tags = true
  endif

  # Dimensions read the three component metafields once
  # so the render site can reuse them without re-reading.
  assign pd_dim_l = blank
  assign pd_dim_w = blank
  assign pd_dim_h = blank
  assign pd_dim_unit = 'cm'
  assign pd_render_dimensions = false
  if block.settings.show_dimensions
    assign pd_dim_l = blank
    assign pd_dim_l = block.settings.length
    if pd_dim_l == blank
      assign mf_path = settings.kt_mf_length | strip | split: '.'
      if mf_path.size == 2
        assign pd_dim_l = product.metafields[mf_path[0]][mf_path[1]].value
      endif
    endif
    assign pd_dim_w = blank
    assign pd_dim_w = block.settings.width
    if pd_dim_w == blank
      assign mf_path = settings.kt_mf_width | strip | split: '.'
      if mf_path.size == 2
        assign pd_dim_w = product.metafields[mf_path[0]][mf_path[1]].value
      endif
    endif
    assign pd_dim_h = blank
    assign pd_dim_h = block.settings.height
    if pd_dim_h == blank
      assign mf_path = settings.kt_mf_height | strip | split: '.'
      if mf_path.size == 2
        assign pd_dim_h = product.metafields[mf_path[0]][mf_path[1]].value
      endif
    endif
    assign pd_dim_unit = blank
    assign pd_dim_unit = block.settings.dimension_unit
    if pd_dim_unit == blank
      assign mf_path = settings.kt_mf_dim_unit | strip | split: '.'
      if mf_path.size == 2
        assign pd_dim_unit = product.metafields[mf_path[0]][mf_path[1]].value
      endif
    endif
    assign pd_dim_unit = pd_dim_unit | default: 'cm'
    if pd_dim_l != blank or pd_dim_w != blank or pd_dim_h != blank
      assign pd_render_dimensions = true
    endif
  endif

  # pd_any is the OR of all per-row flags — single
  # source of truth deciding whether the description
  # list opens at all.
  assign pd_any = false
  if pd_render_sku or pd_render_barcode or pd_render_weight or pd_render_vendor or pd_render_type or pd_render_origin or pd_render_tags or pd_render_dimensions
    assign pd_any = true
  endif
-%}
{%- if pd_any -%}
  <dl class="kt-pdp__details kt-pdp__details--{{ block.settings.layout | default: 'inline' }}" {{ block.shopify_attributes }}>
    {%- comment -%}
      Variant-dependent rows (SKU, barcode, weight) carry
      a `data-product-detail-row="X"` wrapper so product-
      form.js can hide/show + refresh them on variant
      change. We render the row even when the FIRST
      variant's value is blank — the wrapper is hidden
      server-side via the `hidden` attribute when blank,
      but JS can then UN-hide and populate it when the
      customer picks a variant whose field is filled.
      Without this two-state pre-render the row would
      stay missing from the DOM and JS would have
      nothing to update.
    {%- endcomment -%}
    {%- if pd_render_sku -%}
      <div class="kt-pdp__details-row" data-product-detail-row="sku"{% if pd_variant.sku == blank %} hidden{% endif %}>
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.sku' | t }}</dt>
        <dd class="kt-pdp__details-value" data-product-sku>{{ pd_variant.sku | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if pd_render_barcode -%}
      <div class="kt-pdp__details-row" data-product-detail-row="barcode"{% if pd_variant.barcode == blank %} hidden{% endif %}>
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.barcode' | t }}</dt>
        <dd class="kt-pdp__details-value" data-product-barcode>{{ pd_variant.barcode | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if pd_render_weight -%}
      {%- comment -%}
        `data-weight-unit` on the row carries the merchant's
        configured weight unit so kt-product-form.js doesn't
        have to guess on variant change (some products mix
        unit per variant, but Shopify exposes a single
        `weight_unit` per variant in the JSON — we surface
        whichever one the selected variant declares). The
        attribute is a JS read-only ground truth so weight
        format never accidentally renders kg-on-an-oz shop.
      {%- endcomment -%}
      <div class="kt-pdp__details-row" data-product-detail-row="weight" data-weight-unit="{{ pd_variant.weight_unit | escape }}"{% if pd_variant.weight <= 0 %} hidden{% endif %}>
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.weight' | t }}</dt>
        <dd class="kt-pdp__details-value" data-product-weight>{% if pd_variant.weight > 0 %}{{ pd_variant.weight | weight_with_unit: pd_variant.weight_unit }}{% endif %}</dd>
      </div>
    {%- endif -%}
    {%- if pd_render_dimensions -%}
      {%- comment -%}
        Every dim value is `| escape`d at output — the
        metafields are merchant-trusted (admin-set) but
        customer-untrusted on render. A
        `single_line_text_field` typed metafield could
        accept any string including HTML; escaping
        defangs the stored-XSS vector.

        `dimensions_unit` falls back to `cm` for new
        shops with no metafield set. Merchants on
        Imperial-locale Markets should set the metafield
        to `in` per product or globally — there's no
        shop-locale-aware Shopify-native dimensions
        unit. The metafield values + unit are read once
        in the `liquid` block above and reused here.
      {%- endcomment -%}
      <div class="kt-pdp__details-row">
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.dimensions' | t }}</dt>
        <dd class="kt-pdp__details-value">
          {%- if pd_dim_l != blank -%}{{ pd_dim_l | escape }}{%- endif -%}
          {%- if pd_dim_w != blank -%}{% if pd_dim_l != blank %} × {% endif %}{{ pd_dim_w | escape }}{%- endif -%}
          {%- if pd_dim_h != blank -%}{% if pd_dim_l != blank or pd_dim_w != blank %} × {% endif %}{{ pd_dim_h | escape }}{%- endif -%}
          {%- if pd_dim_unit != blank %} {{ pd_dim_unit | escape }}{%- endif -%}
        </dd>
      </div>
    {%- endif -%}
    {%- if pd_render_vendor -%}
      <div class="kt-pdp__details-row">
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.vendor' | t }}</dt>
        <dd class="kt-pdp__details-value">
          <a href="{{ product.vendor | url_for_vendor }}" class="kt-pdp__details-link">{{ product.vendor | escape }}</a>
        </dd>
      </div>
    {%- endif -%}
    {%- if pd_render_type -%}
      <div class="kt-pdp__details-row">
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.type' | t }}</dt>
        <dd class="kt-pdp__details-value">
          <a href="{{ product.type | url_for_type }}" class="kt-pdp__details-link">{{ product.type | escape }}</a>
        </dd>
      </div>
    {%- endif -%}
    {%- if pd_render_origin -%}
      <div class="kt-pdp__details-row">
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.origin' | t }}</dt>
        <dd class="kt-pdp__details-value">{{ pd_origin | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if pd_render_tags -%}
      <div class="kt-pdp__details-row kt-pdp__details-row--tags">
        <dt class="kt-pdp__details-label">{{ 'kt.product.details.tags' | t }}</dt>
        <dd class="kt-pdp__details-value">
          {%- comment -%}
            Tag URL inlines `{{ routes.collections_url }}`
            + `/all/` + `{{ tag | handle }}` so Markets
            locales (e.g. /de/collections/all/sale) stay
            correct. Earlier this was built via `assign`
            with a trailing `| append: tag | handle` —
            Liquid filter chaining ran `| handle` against
            the WHOLE concatenated URL string, producing a
            broken slug like `collections-all-sale` and
            sending every tag chip to a 404. The inline
            pattern matches the proven `main-blog.liquid`
            convention.

            Shopify doesn't ship a `url_for_tag` filter
            (cf. `url_for_vendor` / `url_for_type` which
            do exist) — this manual construction is the
            documented portable approach. Internal tags
            prefixed with `_` are filtered out to match
            the rest of the theme's convention.

            `limit: 30` bounds iteration on pathological
            products with hundreds of tags — keeps the
            PDP HTML payload predictable.
          {%- endcomment -%}
          {%- for tag in product.tags limit: 30 -%}
            {%- unless tag contains '_' -%}
              <a href="{{ routes.collections_url }}/all/{{ tag | handle }}" class="kt-pdp__details-tag">{{ tag | escape }}</a>
            {%- endunless -%}
          {%- endfor -%}
        </dd>
      </div>
    {%- endif -%}
  </dl>
{%- elsif request.design_mode -%}
  {%- comment -%}
    Editor-only hint when no fields are toggled OR all
    toggled fields are empty on the current product.
    Helps the merchant figure out why their block isn't
    rendering anything on the live store.
  {%- endcomment -%}
  <div class="kt-pdp__details kt-pdp__details--placeholder" {{ block.shopify_attributes }}>
    <p class="kt-pdp__details-hint">{{ 'kt.product.details.editor_hint' | t }}</p>
  </div>
{%- endif -%}
