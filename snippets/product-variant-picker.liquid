
{%- assign vp_uid = product.id -%}
{%- if section and section.id -%}
  {%- assign vp_uid = product.id | append: '-' | append: section.id -%}
{%- endif -%}

{%- unless product.has_only_default_variant or product.variants.size == 1 -%}
  <div class="kt-variant-picker" data-variant-picker>
    {%- for option in product.options_with_values -%}
      {%- assign option_name_lower = option.name | downcase -%}
      {%- assign is_color = false -%}
      {%- comment -%}
        Swatches show for any option whose values carry a native Shopify
        swatch (color or image), and for options named like a color.
      {%- endcomment -%}
      {%- assign color_option_names = 'color,colour,renk,finish,couleur,farbe' | split: ',' -%}
      {%- if color_option_names contains option_name_lower or option.values.first.swatch != blank -%}
        {%- assign is_color = true -%}
      {%- endif -%}

      {%- comment -%}
        Resolve the currently selected option value from the active
        variant so deep-links (?variant=...) and back-button restores
        paint the correct swatch/button on initial render.
      {%- endcomment -%}
      {%- assign current_option_value = product.selected_or_first_available_variant.options[forloop.index0] | default: option.selected_value | default: option.values.first -%}

      <fieldset class="kt-variant-picker__group" data-option-index="{{ forloop.index0 }}">
        <legend class="kt-variant-picker__label">
          {{ option.name | escape }}:
          <span class="kt-variant-picker__selected" data-option-selected="{{ forloop.index0 }}">
            {{ current_option_value | escape }}
          </span>
        </legend>

        {%- if is_color -%}
          {%- comment -%}
            Swatch resolution priority (modernized 2025):
            1. NATIVE — `value.swatch.color` / `value.swatch.image`.
               Shopify's built-in variant swatch API (auto-derived
               from standard taxonomy colors or merchant-attached
               metaobjects). Zero theme-side setup.
            2. LEGACY metafield — `custom.swatch_color` /
               `custom.swatch_image`. Kept for backwards compat with
               stores that wired the metafield before native
               swatches existed.
            3. VARIANT IMAGE — `matching_variant.featured_image`.
               When the merchant uploads a per-variant image via
               Shopify Admin's standard variant editor (the dashed
               image placeholder next to each variant row), use it
               as the swatch background. Zero metafield setup: just
               drag-drop an image per variant. Most merchant-friendly
               path for non-technical stores.
            4. Hardcoded palette — finish names common in cabinetry
               (oak / walnut / espresso / charcoal …) get a sensible
               default swatch even on a fresh install with zero setup.
            5. CSS Named Color fallback — modern browsers ship 140
               named colors; "Red" / "Navy" / "Salmon" etc. paint
               natively as a last-resort.
          {%- endcomment -%}
          <div class="kt-variant-picker__swatches">
            {%- for value in option.values -%}
              {%- liquid
                # ─── Tier 1: NATIVE Shopify swatch ────────────────
                # `option_value.swatch` is the modern Shopify API:
                # `swatch.color` returns a hex / CSS color string
                # set by the merchant in the variant editor; `swatch
                # .image` returns the image they uploaded. Both are
                # platform-sanitized so they're safe to drop into an
                # inline style without re-validation.
                assign native_swatch_color = nil
                assign native_swatch_image = nil
                if value.swatch
                  if value.swatch.color != blank
                    assign native_swatch_color = value.swatch.color
                  endif
                  if value.swatch.image != blank
                    assign native_swatch_image = value.swatch.image
                  endif
                endif

                # ─── Tier 2: LEGACY metafield swatch ──────────────
                assign matching_variant = nil
                assign option_available = false
                for v in product.variants
                  if v.options contains value
                    if matching_variant == nil
                      assign matching_variant = v
                    endif
                    if v.available
                      assign option_available = true
                      break
                    endif
                  endif
                endfor

                assign swatch_meta_color = nil
                assign swatch_meta_image = nil
                if matching_variant
                  comment
                    Access the .value accessor explicitly and coerce through
                    `strip` so list/JSON coercion of the metafield wrapper
                    object can't accidentally slip raw object syntax into
                    the style attribute. Metafield TYPE `color` returns a
                    hex string (e.g. "#1A1A1A"); `single_line_text_field`
                    returns whatever the merchant typed — and without the
                    sanitization below, a merchant with metafield write
                    access could paste `red; background-image: url(...)`
                    and inject arbitrary CSS into every product page.
                  endcomment
                  assign swatch_meta_color = blank
                  assign mf_path = settings.kt_mf_swatch_color | strip | split: '.'
                  if mf_path.size == 2
                    assign swatch_meta_color = matching_variant.metafields[mf_path[0]][mf_path[1]].value
                  endif
                  assign swatch_meta_color = swatch_meta_color | strip
                  assign swatch_meta_image = blank
                  assign mf_path = settings.kt_mf_swatch_image | strip | split: '.'
                  if mf_path.size == 2
                    assign swatch_meta_image = matching_variant.metafields[mf_path[0]][mf_path[1]].value
                  endif
                endif

                comment
                  Sanitize the legacy metafield color before it hits an
                  inline style. Only accept CSS hex (#rgb / #rrggbb /
                  #rrggbbaa). Anything else (including `red`, `rgb(...)`,
                  `var(...)`, free text) is rejected so a write-capable
                  metafield editor can't embed `; background-image:
                  url(...)` into every variant picker.

                  Shopify Liquid has no regex — use an alphabet-strip
                  pattern: after `remove`-ing every valid hex char, the
                  candidate must be empty. Then check length is 4/7/9
                  (with the leading `#`).
                endcomment
                if swatch_meta_color != blank
                  assign hex_candidate = swatch_meta_color | downcase
                  assign hex_stripped = hex_candidate
                  assign hex_stripped = hex_stripped | remove: '#'
                  assign hex_stripped = hex_stripped | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4'
                  assign hex_stripped = hex_stripped | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                  assign hex_stripped = hex_stripped | remove: 'a' | remove: 'b' | remove: 'c' | remove: 'd' | remove: 'e' | remove: 'f'
                  assign hex_size = hex_candidate | size
                  assign is_hex_color = false
                  if hex_stripped == '' and hex_candidate != ''
                    if hex_size == 4 or hex_size == 7 or hex_size == 9
                      assign hex_first = hex_candidate | slice: 0
                      if hex_first == '#'
                        assign is_hex_color = true
                      endif
                    endif
                  endif
                  unless is_hex_color
                    assign swatch_meta_color = nil
                  endunless
                endif

                # ─── Tier 3: Hardcoded palette ────────────────────
                assign color_lower = value | downcase | strip
                assign swatch_hex = ''
                case color_lower
                  when 'black'
                    assign swatch_hex = '#1a1a1a'
                  when 'white', 'arctic white'
                    assign swatch_hex = '#faf9f6'
                  when 'gray', 'grey', 'pebble gray'
                    assign swatch_hex = '#a8a29e'
                  when 'charcoal'
                    assign swatch_hex = '#44403c'
                  when 'espresso'
                    assign swatch_hex = '#3C2415'
                  when 'navy', 'navy blue'
                    assign swatch_hex = '#1e3a5f'
                  when 'walnut'
                    assign swatch_hex = '#5D432C'
                  when 'oak', 'natural oak'
                    assign swatch_hex = '#d2b48c'
                  when 'brown'
                    assign swatch_hex = '#6b4e31'
                  when 'beige', 'ivory'
                    assign swatch_hex = '#e8dccc'
                  when 'ice'
                    assign swatch_hex = '#e6eef2'
                  when 'dark'
                    assign swatch_hex = '#1c1917'
                  else
                    assign swatch_hex = ''
                endcase

                # ─── Resolve final style ──────────────────────────
                assign swatch_style = ''
                if native_swatch_image != blank
                  assign swatch_image_url = native_swatch_image | image_url: width: 80
                  assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: '); background-size: cover; background-position: center;'
                elsif native_swatch_color != blank
                  assign swatch_style = 'background-color: ' | append: native_swatch_color | append: ';'
                elsif swatch_meta_image != blank
                  assign swatch_image_url = swatch_meta_image | image_url: width: 80
                  assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: '); background-size: cover; background-position: center;'
                elsif swatch_meta_color != blank
                  assign swatch_style = 'background-color: ' | append: swatch_meta_color | append: ';'
                elsif matching_variant.featured_image != blank
                  # Tier 3 — Variant image as swatch backdrop. Lets the
                  # merchant set a swatch by just uploading an image in
                  # the standard variant editor — no metafield setup.
                  # Object-fit: cover via background-size keeps the
                  # image fitted to the round chip.
                  assign swatch_image_url = matching_variant.featured_image | image_url: width: 80
                  assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: '); background-size: cover; background-position: center;'
                elsif swatch_hex != blank
                  assign swatch_style = 'background-color: ' | append: swatch_hex | append: ';'
                else
                  # Tier 5 — Fall back to the CSS color name. Modern
                  # browsers accept 140 named colors so generic
                  # palettes paint without merchant configuration.
                  assign swatch_style = 'background-color: ' | append: color_lower | append: ';'
                endif
              -%}

              {%- capture swatch_a11y_label -%}
                {{ option.name }}: {{ value }}{% unless option_available %}, {{ 'kt.product.sold_out' | t }}{% endunless %}
              {%- endcapture -%}
              <label class="kt-variant-picker__swatch-label{% unless option_available %} kt-variant-picker__swatch-label--soldout{% endunless %}">
                <input
                  type="radio"
                  name="option-{{ vp_uid }}-{{ forloop.parentloop.index0 }}-{{ option.name | handle }}"
                  value="{{ value | escape }}"
                  aria-label="{{ swatch_a11y_label | strip | escape }}"
                  {% if value == current_option_value %}checked{% endif %}
                  {% unless option_available %}disabled{% endunless %}
                  class="kt-variant-picker__swatch-input visually-hidden"
                  data-option-value
                >
                <span
                  class="kt-variant-picker__swatch"
                  style="{{ swatch_style }}"
                  title="{{ value | escape }}{% unless option_available %}, {{ 'kt.product.sold_out' | t }}{% endunless %}"
                  aria-hidden="true"
                ></span>
              </label>
            {%- endfor -%}
          </div>

        {%- else -%}
          {%- comment -%} Non-color: grid buttons {%- endcomment -%}
          <div class="kt-variant-picker__buttons">
            {%- for value in option.values -%}
              {%- liquid
                assign option_available = false
                for v in product.variants
                  if v.options contains value and v.available
                    assign option_available = true
                    break
                  endif
                endfor
              -%}
              {%- capture btn_a11y_label -%}
                {{ option.name }}: {{ value }}{% unless option_available %}, {{ 'kt.product.sold_out' | t }}{% endunless %}
              {%- endcapture -%}
              <label class="kt-variant-picker__btn-label{% unless option_available %} kt-variant-picker__btn-label--soldout{% endunless %}">
                <input
                  type="radio"
                  name="option-{{ vp_uid }}-{{ forloop.parentloop.index0 }}-{{ option.name | handle }}"
                  value="{{ value | escape }}"
                  aria-label="{{ btn_a11y_label | strip | escape }}"
                  {% if value == current_option_value %}checked{% endif %}
                  {% unless option_available %}disabled{% endunless %}
                  class="kt-variant-picker__btn-input visually-hidden"
                  data-option-value
                >
                <span class="kt-variant-picker__btn">{{ value }}</span>
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}

    {%- comment -%}
      Hidden select used purely as a variant-JSON registry and change
      target for kt-product-form.js. It is NOT a form field — we deliberately
      omit `name="id"` so it cannot collide with the real hidden input
      inside `{%- form 'product' -%}` (see snippets/product-form.liquid).
      That hidden input is the single source of truth for the variant id
      sent to /cart/add; kt-product-form.js rewrites its value whenever this
      select changes (data-variant-select listener).
    {%- endcomment -%}
    <select class="visually-hidden" data-variant-select aria-label="{{ 'kt.product.variant' | t | default: 'Variant' }}" tabindex="-1">
      {%- for variant in product.variants -%}
        <option
          value="{{ variant.id }}"
          {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
          {% unless variant.available %}disabled{% endunless %}
        >
          {{ variant.title | escape }}
        </option>
      {%- endfor -%}
    </select>

    {%- comment -%}
      `type="application/json"` is NOT executed by the browser — it's
      data storage with JSON-safe content. Shopify's `| json` filter
      handles all the escape/encoding so no additional `| escape`
      is needed (application/json context, not HTML attribute).
    {%- endcomment -%}
    <script type="application/json" data-variant-data>{{ product.variants | json }}</script>

    <script type="application/json" data-option-values-map>{
      {%- for variant in product.variants -%}
        "{{ variant.id }}": [
          {%- for ov in variant.option_values -%}
            {{ ov.id }}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }</script>
  </div>

  {%- comment -%}
    JS-off fallback. Our primary variant UI above is a set of radio/swatch
    fieldsets that talk to kt-product-form.js; with JS disabled they do not
    update the hidden `name="id"` input inside the product form and the
    customer is stuck on whichever variant happened to be active at page
    load. The pattern below — a visible-only-when-JS-is-off native
    <select name="id"> that posts to /cart/add directly via its own
    form — is the standard OS 2.0 progressive-enhancement pattern.
    The picker itself is wrapped in <noscript> so it is *hidden when
    JS is on*, preventing duplicate controls from conflicting. The
    form's submit button is labeled "Select variant" and relies on
    the browser's native form POST to the cart — no JS needed.
  {%- endcomment -%}
  <noscript>
    {%- comment -%}
      Quantity input mirrors the JS-on form's quantity_rule plumbing.
      Without a `name="quantity"` field, /cart/add defaults qty=1 — for
      a variant whose merchant set quantity_rule.min > 1 (e.g. case-of-6
      wholesale), the JS-off submit always 422s and the customer lands
      on /cart with a generic flash. Honoring the rule here keeps the
      no-JS path usable for B2B / wholesale buyers.
    {%- endcomment -%}
    {%- assign nojs_qty_min = product.selected_or_first_available_variant.quantity_rule.min | default: 1 -%}
    {%- assign nojs_qty_step = product.selected_or_first_available_variant.quantity_rule.increment | default: 1 -%}
    {%- assign nojs_qty_max = product.selected_or_first_available_variant.quantity_rule.max -%}
    {%- form 'product', product, class: 'kt-variant-picker__nojs' -%}
      <label for="VariantNoJs-{{ vp_uid }}" class="kt-variant-picker__nojs-label">
        {{ 'kt.product.variant' | t | default: 'Variant' }}
      </label>
      <select id="VariantNoJs-{{ vp_uid }}" name="id" class="kt-variant-picker__nojs-select">
        {%- for variant in product.variants -%}
          <option
            value="{{ variant.id }}"
            {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
            {{ variant.title | escape }}
            {%- unless variant.available %}, {{ 'kt.product.sold_out' | t | default: 'sold out' }}{% endunless -%}
            {%- if variant.available %}, {{ variant.price | money }}{% endif -%}
          </option>
        {%- endfor -%}
      </select>
      <label for="QuantityNoJs-{{ vp_uid }}" class="kt-variant-picker__nojs-label">
        {{ 'kt.product.quantity.label' | t | default: 'Quantity' }}
      </label>
      <input
        type="number"
        id="QuantityNoJs-{{ vp_uid }}"
        name="quantity"
        value="{{ nojs_qty_min }}"
        min="{{ nojs_qty_min }}"
        step="{{ nojs_qty_step }}"
        {% if nojs_qty_max != blank %}max="{{ nojs_qty_max }}"{% endif %}
        inputmode="numeric"
        class="kt-variant-picker__nojs-qty"
      >
      <button type="submit" class="kt-variant-picker__nojs-submit">
        {{ 'kt.product.add_to_cart' | t | default: 'Add to cart' }}
      </button>
    {%- endform -%}
  </noscript>
{%- endunless -%}
