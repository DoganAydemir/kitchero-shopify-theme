<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <script>document.documentElement.className='js';</script>

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variants (body and heading, base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.kt_body_font.system? and settings.kt_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}
    {% unless settings.kt_body_font.system? %}
      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.kt_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.kt_heading_font.system? %}
      {{ settings.kt_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {%- render 'critical-css' -%}
    <link rel="stylesheet" href="{{ 'kt-base.css' | asset_url }}" media="all">

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}


    <script src="{{ 'kt-global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'kt-page-behavior.js' | asset_url }}" defer="defer"></script>

    {%- if request.design_mode -%}
      <script src="{{ 'kt-editor-block-affordance.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- comment -%}
      Motion bundle is ~100 KB unminified (GSAP + ScrollTrigger + Lenis +
      smooth-scroll). Only the marketing-heavy templates actually use it
      — the cart, search, 404, gift-card, customers/*, and policies
      templates do zero scroll animation, so we gate the load behind a
      template whitelist. Shrinks TTI and mobile data usage on the pages
      shoppers hit during the conversion funnel. `request.page_type`
      also covers custom JSON templates the merchant adds later, where
      `template.name` may be a sub-template string like `page.custom`.
    {%- endcomment -%}
    {%- liquid
      assign load_motion = settings.kt_motion_reveal
      if request.page_type == 'cart' or request.page_type == 'gift_card' or request.page_type == 'password' or request.page_type == '404' or request.page_type == 'captcha' or request.page_type == 'policy'
        assign load_motion = false
      endif
      if request.page_type contains 'customers/'
        assign load_motion = false
      endif
    -%}
    {%- comment -%}
      Scroll animation libraries load only on screens 750px and wider
      when the visitor hasn't asked for reduced motion. Section scripts
      wait for `kt:motion-ready` through window.ktWhenMotion; on phones
      and with reduced motion they run right away without animation.
    {%- endcomment -%}
    <script>
      (function () {
        var mq = window.matchMedia;
        var wanted = {{ load_motion | json }} && !!mq && mq('(min-width: 750px)').matches && !mq('(prefers-reduced-motion: reduce)').matches;
        var done = false;
        window.ktMotionPending = wanted;
        function ready() {
          if (done) return;
          done = true;
          window.ktMotionPending = false;
          document.dispatchEvent(new CustomEvent('kt:motion-ready'));
        }
        window.ktWhenMotion = function (cb) {
          if (window.ktMotionPending) {
            document.addEventListener('kt:motion-ready', function () { cb(); }, { once: true });
          } else {
            cb();
          }
        };
        if (!wanted) return;
        var urls = [
          {{ 'vendor-gsap.js' | asset_url | json }},
          {{ 'vendor-scrolltrigger.js' | asset_url | json }},
          {{ 'vendor-lenis.js' | asset_url | json }},
          {{ 'smooth-scroll.js' | asset_url | json }}
        ];
        var left = urls.length;
        urls.forEach(function (url) {
          var script = document.createElement('script');
          script.src = url;
          script.async = false;
          script.onload = script.onerror = function () {
            left -= 1;
            if (left === 0) ready();
          };
          document.head.appendChild(script);
        });
        setTimeout(ready, 8000);
      })();
    </script>
    {%- comment -%}
      Loader CSS is ~10 KB and only styles an overlay that appears when
      the merchant has enabled `kt_loader_enable` in Theme Settings.
      Gating the stylesheet behind the same toggle skips the request
      entirely on stores that have the intro loader disabled — direct
      LCP/FCP win without touching the JS bootstrap (which does its
      own `loaderEnabled` check below).
    {%- endcomment -%}
    {%- if settings.kt_loader_enable -%}
      <link rel="stylesheet" href="{{ 'kt-loader.css' | asset_url }}" media="all">
    {%- endif -%}

    {%- comment -%}
      Drawer / overlay CSS — loaded in <head> so the stylesheet
      applies before first paint. These files are small (5-10KB
      each) and only render work when the drawer opens, so the
      parser-blocking cost is negligible. Previously emitted in
      <body> with `media="print" onload="this.media='all'"` async-
      swap, but the onload handler didn't fire reliably across
      CSP / extension combos and left the cart drawer unstyled:
      opened drawer rendered full-width instead of a right-side
      panel. <head>-loaded `stylesheet_tag` guarantees application.
    {%- endcomment -%}
    {%- if settings.kt_cart_type == 'drawer' -%}
      <link rel="stylesheet" href="{{ 'kt-cart-drawer.css' | asset_url }}" media="all">
    {%- endif -%}

    {%- if settings.kt_search_overlay_enabled == nil or settings.kt_search_overlay_enabled -%}
      <link rel="stylesheet" href="{{ 'kt-search-overlay.css' | asset_url }}" media="all">
    {%- endif -%}
    {%- if settings.kt_appointment_enabled -%}
      <link rel="stylesheet" href="{{ 'kt-appointment-drawer.css' | asset_url }}" media="all">
    {%- endif -%}

    <link rel="stylesheet" href="{{ 'kt-section-header.css' | asset_url }}" media="all">

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {%- comment -%}
        Localization stylesheet was previously preloaded — counted
        as a 5th resource hint. Now lazy-loaded via plain
        stylesheet_tag (no preload kw), saving the hint slot for
        body+heading fonts above. The selector is below-fold in
        the footer (mobile drawer is opened on demand) so async
        load is acceptable.
      {%- endcomment -%}
      <link rel="stylesheet" href="{{ 'kt-localization-form.css' | asset_url }}" media="all">
      <script src="{{ 'kt-localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- comment -%}
      Loader bootstrap: decides — before first paint — whether to skip
      the intro loader. Added here (not in kt-loader.js) because the JS
      file is deferred and by the time it runs the loader would already
      have flashed visible. Adds a class to <html> so CSS can hide the
      loader with `display: none` from the very first paint.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var loaderEnabled = {{ settings.kt_loader_enable | json }};
          if (!loaderEnabled ||
              sessionStorage.getItem('kitchero:loader-shown') ||
              (window.Shopify && Shopify.designMode)) {
            document.documentElement.classList.add('kt-loader-skip');
          }
        } catch (e) {
          /* Private mode / storage blocked — show the loader anyway. */
        }
      })();
    </script>
    <script src="{{ 'kt-loader.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="gradient" data-kt-scheme="{{ settings.kt_schemes.first.id }}" data-cart-type="{{ settings.kt_cart_type | default: 'drawer' }}">
    {%- render 'kt-loader' -%}

    <a class="kt-skip-link button visually-hidden" href="#MainContent">
      {{ 'kt.a11y.skip_to_text' | t }}
    </a>

    {%- comment -%}
      Global assertive + polite announcer regions. Any part of the
      theme can push a message by writing to `#ktAnnouncer` (polite,
      non-interrupting: filter/sort updates, ATC success, share
      copied) or `#ktAnnouncerAlert` (assertive: validation errors,
      destructive-action confirmations). Hidden visually but read
      out to assistive tech.

      Why a GLOBAL live region and not per-section ones: SRs don't
      reliably announce newly-inserted aria-live regions — the region
      has to pre-exist and only its textContent change. Keeping two
      persistent regions (polite + assertive) means a drawer or
      section that swaps its DOM out can still emit announcements
      without losing them in the transition.
    {%- endcomment -%}
    {%- comment -%}
      `role="status"` implies `aria-live="polite"` by default, and
      `role="alert"` implies `aria-live="assertive"`. Declaring both
      is redundant ARIA — axe-core flags `aria-redundant` and some
      SRs double-announce. Keep the roles (clearer semantics) and
      drop the implied live values.
    {%- endcomment -%}
    <div
      id="ktAnnouncer"
      class="visually-hidden"
      aria-atomic="true"
      role="status"
    ></div>
    <div
      id="ktAnnouncerAlert"
      class="visually-hidden"
      aria-atomic="true"
      role="alert"
    ></div>

    {%- comment -%}
      Drawer / overlay MARKUP. The stylesheets themselves load in
      <head> (above) so the panels are already styled when they
      render. Markup kept in <body> so it lives inside the layout
      flow (and so `{% section 'cart-drawer' %}` participates in
      the Section Rendering API for AJAX refresh).

      TSB-001 (Theme Store rule "static sections can't be added or
      removed by Liquid templates or layouts"): the section is
      now ALWAYS rendered. The internal `settings.kt_cart_type`
      gate moved into sections/cart-drawer.liquid so the section
      participates unconditionally in the layout while emitting
      empty markup on stores configured for "page" cart mode.
      Keeps Section Rendering API hooks consistent and matches
      Shopify Skeleton's pattern for optional drawers.
    {%- endcomment -%}
    {% section 'cart-drawer' %}
    {%- render 'search-overlay' -%}
    <script src="{{ 'search-overlay.js' | asset_url }}" defer="defer"></script>
    {%- if settings.kt_appointment_enabled -%}
      {%- render 'appointment-drawer' -%}
      <script src="{{ 'appointment-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- comment -%}
      Scopes contact-form success/error feedback to the form that was
      actually submitted (assets/kt-form-scope.js). Loaded globally: the
      showroom can show two {% form 'contact' %} blocks (studio form +
      consultation drawer), and Shopify's page-global posted flag would
      otherwise surface feedback on both. Keyed off the URL fragment.
    {%- endcomment -%}
    <script src="{{ 'kt-form-scope.js' | asset_url }}" defer="defer"></script>

    {% sections 'header-group' %}

    {%- comment -%}
      Breadcrumb is NOT rendered at the top of `<main>` anymore.
      Earlier iterations tried two reorder strategies — DOM-first
      with `.kt-main-flex` flex `order` shuffling, then DOM-first
      with CSS `:has()` — but both broke on single-section
      templates (blog, article, search, collection, product)
      where the whole main-* section is one `<div class="shopify-
      section">` wrapping both the intro hero AND the body grid:
      flex order only reshuffles section-level siblings, so the
      breadcrumb would slide visually past the entire body grid
      and land just above the footer.

      The reliable fix is to render the breadcrumb INSIDE the
      intro component itself. `snippets/page-header-dotted.liquid`
      renders the breadcrumb as its last visual element, so every
      template that uses that snippet (page, blog, collection,
      cart, deals, newsletter) auto-positions the trail right
      under the dotted header. For templates with their own intro
      design (main-article, main-search, main-product, main-
      collection-banner) the breadcrumb is rendered inside each
      section liquid at the right insertion point.
    {%- endcomment -%}
    <main id="MainContent" class="content-for-layout focus-none" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% sections 'overlay-group' %}

    {%- comment -%} Structured Data (JSON-LD) {%- endcomment -%}
    {%- render 'structured-data' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'kt.a11y.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'kt.a11y.link.new_window' | t }}</li>
    </ul>

    <script>
      // Bootstrap the Kitchero runtime namespace. `kt-global.js` (loaded with
      // defer) adds focusTrap / bus / escapeCloseDetails to the same object,
      // so the `|| {}` guard lets either script run first.
      window.Kitchero = window.Kitchero || {};

      {%- liquid
        assign search_types = ''
        if settings.kt_search_inc_products
          assign search_types = search_types | append: 'product,'
        endif
        if settings.kt_search_inc_pages
          assign search_types = search_types | append: 'page,'
        endif
        if settings.kt_search_inc_articles
          assign search_types = search_types | append: 'article,'
        endif
        if settings.kt_search_inc_collections
          assign search_types = search_types | append: 'collection,'
        endif
        assign search_types = search_types | split: ',' | join: ','
        # Products, pages and articles all off: suggest all three (same rule as the search page).
        unless settings.kt_search_inc_products or settings.kt_search_inc_pages or settings.kt_search_inc_articles
          assign search_types = search_types | prepend: 'product,page,article,' | split: ',' | join: ','
        endunless
      -%}
      {%- comment -%}
        Every value interpolated into this JS blob is emitted via
        `| json` so Shopify produces a fully JS-string-literal-safe
        value (with surrounding double quotes). This closes two
        injection vectors:

        1. Single-quoted strings: a variant title / route with `'` in
           it would otherwise break out.
        2. Backtick template literals: a translation containing
           `${...}` would otherwise be parsed as a JS expression
           (merchant-localized strings can easily carry `$`).

        Shopify `| json` produces proper JSON, which is itself valid
        JS syntax for strings / numbers — no extra quoting needed on
        our side.
      {%- endcomment -%}
      Object.assign(window.Kitchero, {
        shopUrl: {{ request.origin | json }},
        routes: {
          cartAdd:          {{ routes.cart_add_url | json }},
          cartChange:       {{ routes.cart_change_url | json }},
          cartUpdate:       {{ routes.cart_update_url | json }},
          cart:             {{ routes.cart_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          {%- comment -%}
            `search` was missing here; kt-predictive-search.js's "press
            Enter to search anyway" path was hardcoding `/search`,
            which 404s on multi-locale storefronts where the locale
            prefix is required (e.g. `/de/search`). `routes.search_url`
            resolves to the correct localized path on every Market.
          {%- endcomment -%}
          search:           {{ routes.search_url | json }},
        },
        searchSettings: {
          {%- comment -%}
            Placeholder convention — pass `[count]` / `[subtotal]` as
            the `| t:` argument so the rendered string has a JS-
            replaceable token (square brackets). We previously used
            Liquid-style curly-brace placeholders (count in double
            braces) which collide with Liquid's own tag syntax:
            Shopify's parser greedy-matches the closing double-brace
            from INSIDE the nested string and closes the outer filter
            tag early, spilling raw Liquid source into the page → a
            JS SyntaxError when browsers encounter the opener in
            script. Square-bracket placeholders dodge the syntax
            conflict entirely and follow Skeleton's placeholder
            convention. Also: keep this comment free of literal
            double-brace sequences — Liquid comment tags do NOT
            sandbox embedded output delimiters from the parser, and
            a stray pair inside a comment will be reported as an
            unclosed comment tag at the line of the outer open.
          {%- endcomment -%}
          types:               {{ search_types | json }},
          resultsAnnouncement: {{ 'kt.search.results_announcement' | t: count: '[count]' | json }},
          noResults:           {{ 'kt.search.no_results_announcement' | t | json }},
          offline:             {{ 'kt.search.offline' | t | json }},
          rateLimited:         {{ 'kt.search.rate_limited' | t | json }},
          genericError:        {{ 'kt.search.generic_error' | t | json }},
          groupProducts:       {{ 'kt.search.scope_products'    | t | json }},
          groupCollections:    {{ 'kt.search.scope_collections' | t | json }},
          groupArticles:       {{ 'kt.search.scope_articles'    | t | json }},
          groupPages:          {{ 'kt.search.scope_pages'       | t | json }},
          resultsLabel:        {{ 'kt.search.search'            | t | json }},
          viewAll:             {{ 'kt.search.view_all'          | t | json }}
        },
        cartStrings: {
          error:           {{ 'kt.cart.cart_error' | t | json }},
          quantityError:   {{ 'kt.cart.cart_quantity_error_html' | t: quantity: '[quantity]' | json }},
          updatedSubtotal: {{ 'kt.cart.updated_subtotal' | t: subtotal: '[subtotal]' | json }},
        },
        moneyFormat:             {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        variantStrings: {
          addToCart:      {{ 'kt.product.add_to_cart' | t | json }},
          addSubscription: {{ 'kt.product.add_subscription_to_cart' | t | json }},
          addedToCart:    {{ 'kt.product.added_to_cart' | t | json }},
          addToCartError: {{ 'kt.product.add_to_cart_error' | t | json }},
          offlineError:   {{ 'kt.product.offline_error' | t | json }},
          timeoutError:   {{ 'kt.product.timeout_error' | t | json }},
          soldOut:        {{ 'kt.product.sold_out' | t | json }},
          unavailable:    {{ 'kt.product.unavailable' | t | json }},
          subscriptionUnavailable: {{ 'kt.product.subscription_unavailable' | t | json }},
          lowStockHtml:    {{ 'kt.product.low_stock_html' | t: count: '[count]' | json }},
          lowStockOneHtml: {{ 'kt.product.low_stock_html' | t: count: 1 | replace: '1', '[count]' | json }},
          {%- comment -%}
            Volume pricing tier label template. `[qty]` placeholder
            is replaced by kt-product-form.js when rebuilding the
            quantity-price-break <li> rows on variant change.
            Without this template the JS would have to hardcode
            "X+ items" in English and break for FR/DE/TR/ES.
          {%- endcomment -%}
          volumeQtyHtml:  {{ 'kt.product.volume_qty_html' | t: qty: '[qty]' | json }},
        },
        lowStockThreshold: {% if settings.kt_show_low_stock %}{{ settings.kt_low_stock_threshold | default: 0 }}{% else %}0{% endif %},
        a11yStrings: {
          imageAvailable: {{ 'kt.product.media.image_available' | t: index: '[index]', total: '[total]' | json }},
          shareSuccess:   {{ 'kt.share.success_message' | t | json }},
        }
      });
    </script>

    {%- if settings.kt_cart_type == 'drawer' -%}
      {%- comment -%}
        The cart drawer script loads after the page is idle or on the first
        interaction. window.ktLoadCartDrawer(callback) runs the callback once
        the drawer is ready; a cart icon click before that waits for it.
      {%- endcomment -%}
      <script>
        (function () {
          var state = 0;
          var queue = [];
          function flush() {
            customElements.whenDefined('cart-drawer').then(function () {
              var callbacks = queue;
              queue = [];
              callbacks.forEach(function (callback) { callback(); });
            });
          }
          function load(callback) {
            if (typeof callback === 'function') queue.push(callback);
            if (state === 2) { flush(); return; }
            if (state === 1) return;
            state = 1;
            var script = document.createElement('script');
            script.src = {{ 'kt-cart-drawer.js' | asset_url | json }};
            script.onload = function () { state = 2; flush(); };
            document.head.appendChild(script);
          }
          window.ktLoadCartDrawer = load;
          document.addEventListener('click', function (event) {
            if (state === 2 && customElements.get('cart-drawer')) return;
            var icon = event.target.closest && event.target.closest('.kt-header__cart-icon');
            if (!icon || !document.querySelector('cart-drawer')) return;
            event.preventDefault();
            load(function () {
              var drawer = document.querySelector('cart-drawer');
              if (drawer && typeof drawer.open === 'function') drawer.open();
            });
          }, true);
          ['pointerdown', 'keydown', 'touchstart'].forEach(function (type) {
            document.addEventListener(type, function () { load(); }, { once: true, passive: true });
          });
          window.addEventListener('load', function () {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(function () { load(); }, { timeout: 3000 });
            } else {
              setTimeout(load, 2000);
            }
          });
        })();
      </script>
    {%- endif -%}

    {%- if settings.kt_search_predictive -%}
      {%- comment -%} Predictive search loads when a shopper first opens or focuses search. {%- endcomment -%}
      <script>
        (function () {
          var loaded = false;
          function load(event) {
            var target = event.target;
            if (loaded || !target || !target.closest || !target.closest('[data-search-input], [data-search-open]')) return;
            loaded = true;
            var script = document.createElement('script');
            script.src = {{ 'kt-predictive-search.js' | asset_url | json }};
            script.onload = function () {
              document.querySelectorAll('[data-search-input]').forEach(function (input) {
                if (input.value) input.dispatchEvent(new Event('input', { bubbles: true }));
              });
            };
            document.head.appendChild(script);
          }
          ['pointerdown', 'focusin', 'keydown'].forEach(function (type) {
            document.addEventListener(type, load, true);
          });
        })();
      </script>
    {%- endif -%}
  </body>
</html>
