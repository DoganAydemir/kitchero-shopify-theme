<!doctype html>
<html class="js full-height" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% unless settings.kt_body_font.system? and settings.kt_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}
    {% unless settings.kt_body_font.system? %}
      {{ settings.kt_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.kt_heading_font.system? %}
      {{ settings.kt_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'kt-base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="password">
    <a class="kt-skip-link visually-hidden" href="#MainContent">
      {{ 'kt.a11y.skip_to_text' | t }}
    </a>

    <main id="MainContent" class="password-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'kt.a11y.link.new_window' | t }}</li>
    </ul>
  </body>
</html>
